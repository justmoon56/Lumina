function Window:_drag(handle, target, orb)
	local dragging, touch, start, origin, moved

	self:_on(handle.InputBegan, function(input)
		if not Lyra.IsPointer(input) then
			return
		end
		local scale = self.CurrentScale or 1
		if not orb and (
			self.Maximized
			or input.Position.X > self.Main.AbsolutePosition.X + self.Main.AbsoluteSize.X - 146 * scale
			or (self.Narrow and input.Position.X < self.Main.AbsolutePosition.X + 54 * scale)
		) then
			return
		end

		if not orb then
			self:_stopTween(self.Main)
		end

		dragging = true
		touch = input.UserInputType == Enum.UserInputType.Touch and input or nil
		start = Vector2.new(input.Position.X, input.Position.Y)
		origin = target.AbsolutePosition - self.Surface.AbsolutePosition
		moved = false
	end)

	self:_connect(UserInputService.InputChanged, function(input)
		if not dragging then
			return
		end
		if touch and input ~= touch then
			return
		end
		if not touch and input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end

		local delta = Vector2.new(input.Position.X, input.Position.Y) - start
		if delta.Magnitude > 7 then
			moved = true
		end

		if moved then
			if orb then
				self.OrbIgnoreUntil = os.clock() + 1
			end
			local size = self.Surface.AbsoluteSize
			local wanted = origin + delta
			target.Position = UDim2.fromOffset(
				math.clamp(wanted.X, 8, math.max(8, size.X - target.AbsoluteSize.X - 8)),
				math.clamp(wanted.Y, 8, math.max(8, size.Y - target.AbsoluteSize.Y - 8))
			)
		end
	end)

	self:_connect(UserInputService.InputEnded, function(input)
		if dragging and ((touch and input == touch) or (not touch and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			if orb and moved then
				self.OrbIgnoreUntil = os.clock() + 0.3
			end
			dragging = false
			touch = nil
		end
	end)
end

function Window:_buildGrip()
	local grip = Lyra.Inst("TextButton", {
		Name = "ResizeGrip",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -7, 1, -7),
		Size = UDim2.fromOffset(28, 28),
		Text = "",
		BackgroundTransparency = 0.35,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		ZIndex = 30
	}, self.Main)
	self:_paint(grip, {BackgroundColor3 = "Raised"})
	Lyra.Round(grip, 10)

	for i, length in ipairs({16, 10, 4}) do
		local stroke = Lyra.Inst("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(14 + (i - 1) * 3.6, 14 + (i - 1) * 3.6),
			Size = UDim2.fromOffset(length, 2),
			Rotation = -45,
			BorderSizePixel = 0,
			ZIndex = 31
		}, grip)
		self:_paint(stroke, {BackgroundColor3 = "Accent"})
		Lyra.Round(stroke, 2)
	end

	self.ResizeGrip = grip

	self.SizeBadge = Lyra.Inst("TextLabel", {
		AnchorPoint = Vector2.new(1, 1),
		Size = UDim2.fromOffset(96, 26),
		BackgroundTransparency = 1,
		TextTransparency = 1,
		Font = Lyra.Font.Bold,
		TextSize = Lyra.TextSize(12),
		Text = "",
		BorderSizePixel = 0,
		ZIndex = 60
	}, self.Surface)
	self:_paint(self.SizeBadge, {
		BackgroundColor3 = "Base",
		TextColor3 = "Text"
	})
	Lyra.Round(self.SizeBadge, 9)

	local badgeStroke = self:_stroke(self.SizeBadge, 1, "Accent")
	local s = self.Settings

	local function badge(visible)
		self.SizeBadge.Text = tostring(math.floor(s.WindowW)) .. " × " .. tostring(math.floor(s.WindowH))
		local corner = self.Main.AbsolutePosition + self.Main.AbsoluteSize - self.Surface.AbsolutePosition
		self.SizeBadge.Position = UDim2.fromOffset(corner.X - 4, corner.Y - 40)

		self:_tween(self.SizeBadge, {
			BackgroundTransparency = visible and 0.08 or 1,
			TextTransparency = visible and 0 or 1
		}, visible and 0.12 or 0.4)

		self:_tween(badgeStroke, {
			Transparency = visible and 0.35 or 1
		}, visible and 0.12 or 0.4)
	end

	local active, touch, start, startW, startH

	self:_on(grip.InputBegan, function(input)
		if not Lyra.IsPointer(input) then
			return
		end
		active = true
		touch = input.UserInputType == Enum.UserInputType.Touch and input or nil
		start = Vector2.new(input.Position.X, input.Position.Y)
		startW, startH = self.Main.Size.X.Offset, self.Main.Size.Y.Offset
		self.Resizing = true
		self.Maximized = false
		self:_tween(grip, {BackgroundTransparency = 0}, 0.1)
	end)

	self:_connect(UserInputService.InputChanged, function(input)
		if not active then
			return
		end
		if touch and input ~= touch then
			return
		end
		if not touch and input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end

		local scale = self.CurrentScale or 1
		local delta = (Vector2.new(input.Position.X, input.Position.Y) - start) / scale
		local size = self.Surface.AbsoluteSize
		local corner = self.Main.AbsolutePosition - self.Surface.AbsolutePosition

		s.WindowW = math.floor(math.clamp(startW + delta.X, 300, math.max(300, (size.X - corner.X - 10) / scale)))
		s.WindowH = math.floor(math.clamp(startH + delta.Y, 240, math.max(240, (size.Y - corner.Y - 10) / scale)))

		self:_layout(false)
		badge(true)
	end)

	self:_connect(UserInputService.InputEnded, function(input)
		if active and ((touch and input == touch) or (not touch and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			active = false
			touch = nil
			self.Resizing = false
			self:_tween(grip, {BackgroundTransparency = 0.35}, 0.15)
			self:_layout(false)
			self:_queueSave()

			task.delay(0.5, function()
				if self.Alive and not active then
					badge(false)
				end
			end)
		end
	end)
end

function Window:_scale()
	local percent = self.Settings.Scale
	if percent and percent > 0 then
		return percent / 100
	end
	local size = self.Surface and self.Surface.AbsoluteSize or Vector2.new(1280, 720)
	return math.min(size.X, size.Y) < 500 and 0.94 or 1
end

function Window:_layout(center)
	if not self.Main or not self.Alive then
		return
	end
	local size = self.Surface.AbsoluteSize
	if size.X < 1 or size.Y < 1 then
		return
	end

	local s = self.Settings
	local scale = self:_scale()
	local scaleChanged = self.CurrentScale ~= nil and self.CurrentScale ~= scale
	self.CurrentScale = scale

	local motion = self.Resizing and 0.08 or 0.25
	if self.Visible and (scaleChanged or (self.WindowScale.Scale ~= scale and not self.ShowingTo)) then
		self:_tween(self.WindowScale, {Scale = scale}, motion)
	end

	local availW = math.max(300, (size.X - 20) / scale)
	local availH = math.max(240, (size.Y - 20) / scale)
	local phone = math.min(size.X, size.Y) < 500

	local w, h
	if self.Maximized then
		w, h = availW, availH
	else
		w = s.WindowW > 0 and s.WindowW or (phone and 560 or self.DefaultW)
		w = math.clamp(w, 300, availW)
		h = s.WindowH > 0 and s.WindowH or ((phone or w < 520) and availH or self.DefaultH)
		h = math.clamp(h, 240, availH)
	end

	local narrow = w < 520
	local rail = not narrow and (w < 760 and 60 or 196) or 0
	local left = rail > 0 and rail + 18 or 10
	local compact, lowHeight = w - left - 22 < 470, h < 480
	self.Narrow, self.Compact, self.LowHeight = narrow, compact, lowHeight

	local minimized = self.Minimized
	local visualW, visualH = w * scale, (minimized and HEADER or h) * scale

	local pos = self.ShowingTo or self.Main.Position
	local x = center and (size.X - visualW) / 2 or pos.X.Offset
	local y = center and (size.Y - visualH) / 2 or pos.Y.Offset

	local goal = {
		Size = UDim2.fromOffset(w, minimized and HEADER or h),
		Position = UDim2.fromOffset(
			math.clamp(x, 10, math.max(10, size.X - visualW - 10)),
			math.clamp(y, 10, math.max(10, size.Y - visualH - 10))
		)
	}

	if not (self.ShowingTo and self.ShowingTo == goal.Position and self.Main.Size == goal.Size) then
		self:_tween(self.Main, goal, motion)
		if self.ShowingTo then
			self.ShowingTo = goal.Position
		end
	end

	self.Content.Visible = not minimized
	self.StatusFrame.Visible = not minimized
	self.ContentBack.Visible = not minimized
	self.ResizeGrip.Visible = not minimized and not self.Maximized

	self:_tween(self.ContentBack, {
		Position = UDim2.fromOffset(left, HEADER + 6),
		Size = UDim2.new(1, -left - 10, 1, -(HEADER + 6 + 40))
	}, motion)

	self:_tween(self.Content, {
		Position = UDim2.fromOffset(left + 8, HEADER + 12),
		Size = UDim2.new(1, -left - 26, 1, -(HEADER + 12 + 48))
	}, motion)

	self:_tween(self.StatusFrame, {
		Position = UDim2.new(0, left + 6, 1, -36),
		Size = UDim2.new(1, -left - 46, 0, 28)
	}, motion)

	self.Nav.Visible = not minimized and (not narrow or self.Drawer == true)
	self.Nav.Position = UDim2.fromOffset(8, HEADER + 6)
	self:_tween(self.Nav, {
		Size = UDim2.new(0, narrow and 216 or rail, 1, -(HEADER + 16))
	}, motion)

	self.Nav.BackgroundTransparency = narrow and 0.03 or 0.72
	self.DrawerScrim.Position = UDim2.fromOffset(0, HEADER)
	self.DrawerScrim.Size = UDim2.new(1, 0, 1, -HEADER)
	self.DrawerScrim.Visible = narrow and self.Drawer == true and not minimized

	self.MenuButton.Root.Visible = narrow
	self.Logo.Visible = not narrow
	self.HeaderTitle.TextSize = Lyra.TextSize(narrow and 14 or 16)

	local mini = rail == 60
	self:_navLabels(not mini, not lowHeight)

	local first = lowHeight and 6 or 30
	local step = lowHeight and 42 or 46
	local height = lowHeight and 38 or 42
	local slot = 0

	for _, tab in ipairs(self.Tabs) do
		local button = tab.RailButton
		button.Root.Visible = not tab.Hidden
		if not tab.Hidden then
			button.Root.Position = UDim2.fromOffset(5, first + slot * step)
			button.Root.Size = UDim2.new(1, -10, 0, height)
			slot = slot + 1
		end
		if self.LastMini ~= mini then
			self:_tween(button.Icon, {
				Position = UDim2.new(0, mini and 13 or 11, 0.5, -12)
			}, motion)
		end
	end

	self.LastMini = mini
	self.Nav.CanvasSize = UDim2.fromOffset(0, first + slot * step + (lowHeight and 6 or 46))

	local orb = self.Orb.AbsolutePosition - self.Surface.AbsolutePosition
	self.Orb.Position = UDim2.fromOffset(
		math.clamp(orb.X, 8, math.max(8, size.X - 60)),
		math.clamp(orb.Y, 8, math.max(8, size.Y - 60))
	)

	self:_effects()

	local state = {
		Narrow = narrow,
		Compact = compact,
		LowHeight = lowHeight,
		Mini = mini,
		Width = w,
		Height = h
	}
	self.LayoutState = state

	local key = tostring(narrow) .. tostring(compact) .. tostring(lowHeight)
	if key ~= self.LayoutKey then
		self.LayoutKey = key
		Lyra.RunHooks(self.LayoutHooks, state)
	end
end

function Window:_navLabels(show, extras)
	local state = tostring(show) .. tostring(extras)
	if self.NavLabelState == state then
		return
	end

	local first = self.NavLabelState == nil
	self.NavLabelState = state
	self.NavShow = show
	self.NavLabelGeneration = (self.NavLabelGeneration or 0) + 1
	local generation = self.NavLabelGeneration

	local items = {}
	for _, tab in ipairs(self.Tabs) do
		table.insert(items, {Label = tab.RailButton.Label, Show = show})
	end
	table.insert(items, {Label = self.NavCaption, Show = show and extras})
	table.insert(items, {Label = self.NavFooter, Show = show and extras})

	local reduced = self.Settings.ReducedMotion

	for _, item in ipairs(items) do
		local label = item.Label
		if item.Show then
			if first then
				label.Visible = true
				label.TextTransparency = 0
			elseif not label.Visible then
				label.TextTransparency = 1
				label.Visible = true
				task.delay(reduced and 0 or 0.08, function()
					if self.Alive and generation == self.NavLabelGeneration then
						self:_tween(label, {TextTransparency = 0}, 0.22)
					end
				end)
			end
		elseif first then
			label.Visible = false
		elseif label.Visible then
			self:_tween(label, {TextTransparency = 1}, 0.1)
			task.delay(reduced and 0 or 0.1, function()
				if self.Alive and generation == self.NavLabelGeneration then
					label.Visible = false
				end
			end)
		end
	end
end

function Window:_effects(keepOrb)
	local s = self.Settings
	if not keepOrb then
		self.Orb.Visible = (not self.Visible or self.Minimized) and s.FloatingButton == true
	end
	self:_tween(self.Blur, {
		Size = self.Visible and not self.Minimized and s.Blur and not s.LowEffects and 9 or 0
	}, 0.25)
	self.Main.BackgroundTransparency = s.LowEffects and 0 or 0.16
	self.ContentBack.BackgroundTransparency = s.LowEffects and 0 or 0.56
end

function Window:_reopenMethods()
	local methods = {}
	if UserInputService.KeyboardEnabled then
		table.insert(methods, "press " .. self.Settings.Keybind)
	end
	if self.Settings.MenuReopen then
		table.insert(methods, "open and close the Roblox menu 3 times")
	end
	if self.ChatAlias and self.ChatOK ~= false then
		table.insert(methods, "type " .. self.ChatAlias .. " in chat")
	end
	return methods
end

function Window:_canReopen()
	return self.Settings.FloatingButton == true or #self:_reopenMethods() > 0
end

function Window:_reopenText()
	local methods = self:_reopenMethods()
	if #methods == 0 then
		return "Turn on a reopen method in Settings."
	end

	local text
	if #methods == 1 then
		text = methods[1]
	elseif #methods == 2 then
		text = methods[1] .. " or " .. methods[2]
	else
		text = table.concat(methods, ", ", 1, #methods - 1) .. ", or " .. methods[#methods]
	end
	return "To reopen it, " .. text .. "."
end

function Window:_hiddenHint()
	if not self.Settings.FloatingButton then
		self:Notify({
			Title = self.Title .. " hidden",
			Text = self:_reopenText(),
			Kind = "info",
			Icon = "eye-off",
			Duration = 6
		})
	end
end

function Window:Hide()
	self:SetVisible(false)
	self:_hiddenHint()
end

function Window:Show()
	self.Minimized = false
	self:SetVisible(true)
	self:_layout(false)
end

function Window:Toggle()
	if self.Visible then
		self:SetVisible(false)
	else
		self:Show()
	end
end

function Window:Minimize(state)
	self.Minimized = state ~= false
	self:_layout(false)
end

function Window:Maximize(state)
	self.Maximized = state ~= false
	self:_layout(true)
end

function Window:_closeHub()
	if not self.Visible then
		return
	end
	local s = self.Settings

	if self.Options.CloseAction == "Destroy" then
		self:Confirm({
			Title = "Close " .. self.Title .. "?",
			Text = "The window and everything it runs will be closed.",
			Confirm = "Close",
			Cancel = "Keep open",
			Seconds = 10,
			Callback = function()
				self:Destroy()
			end
		})
		return
	end

	if s.FloatingButton then
		self:Hide()
		return
	end

	if #self:_reopenMethods() == 0 then
		self:Confirm({
			Title = "Nothing can reopen the window",
			Text = "There is no keyboard, chat is unavailable and the Roblox menu shortcut is off. Turn the shortcut on and hide the window?",
			Confirm = "Turn on and hide",
			Cancel = "Keep open",
			Seconds = 15,
			Callback = function()
				s.MenuReopen = true
				self:_queueSave()
				self:_syncSetting("MenuReopen")
				self:Hide()
			end
		})
		return
	end

	if not s.HideTipSeen then
		self:Confirm({
			Title = "Hide " .. self.Title .. "?",
			Text = self:_reopenText() .. " Make sure you can use one of these before hiding.",
			Confirm = "Hide it",
			Cancel = "Keep open",
			Seconds = 10,
			Callback = function()
				s.HideTipSeen = true
				self:_queueSave()
				self:Hide()
			end
		})
		return
	end

	self:Hide()
end

local FLIGHT_TIME, FLIGHT_SCALE = 0.42, 0.06

function Window:_orbCenter()
	local size, p = self.Surface.AbsoluteSize, self.Orb.Position
	return Vector2.new(
		p.X.Scale * size.X + p.X.Offset + self.Orb.Size.X.Offset / 2,
		p.Y.Scale * size.Y + p.Y.Offset + self.Orb.Size.Y.Offset / 2
	)
end

function Window:_windowCenter(position, scale)
	return Vector2.new(
		position.X.Offset + self.Main.Size.X.Offset * scale / 2,
		position.Y.Offset + self.Main.Size.Y.Offset * scale / 2
	)
end

function Window:_flightBadge(point)
	if not self.Badge then
		self.Badge = Lyra.Inst("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(56, 56),
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 80
		}, self.Surface)
		self:_paint(self.Badge, {BackgroundColor3 = "AccentDark"})
		Lyra.Round(self.Badge, 18)
		self:_stroke(self.Badge, 0.15, "Accent")
		self:_brandMark(self.Badge, 18, 20)
		self.BadgeScale = Lyra.Inst("UIScale", {Scale = 0}, self.Badge)
	end
	self.Badge.Position = UDim2.fromOffset(point.X, point.Y)
	return self.Badge
end

function Window:SetVisible(value)
	value = value ~= false
	if value == self.Visible or not self.Alive then
		return
	end

	self.VisibilityGeneration = (self.VisibilityGeneration or 0) + 1
	local generation = self.VisibilityGeneration

	if self.Badge then
		self.Badge.Visible = false
	end

	self.Visible = value
	self:_closeDropdown(true)

	local scale = self.CurrentScale or self:_scale()
	local still = self.Settings.ReducedMotion or self.Settings.LowEffects
	local useOrb = self.Settings.FloatingButton == true

	local function later(delay, fn)
		task.delay(still and 0 or delay, function()
			if self.Alive and generation == self.VisibilityGeneration then
				fn()
			end
		end)
	end

	local function spot(point)
		return UDim2.fromOffset(
			point.X - self.Main.Size.X.Offset * scale * FLIGHT_SCALE / 2,
			point.Y - self.Main.Size.Y.Offset * scale * FLIGHT_SCALE / 2
		)
	end

	if type(self.Options.OnVisibilityChanged) == "function" then
		self:_fire(self.Options.OnVisibilityChanged, value)
	end

	if value then
		local home = self.HomePosition or self.Main.Position
		self.HomePosition = nil
		self.ShowingTo = home

		later(FLIGHT_TIME, function()
			self.ShowingTo = nil
		end)

		if self.Main.Visible then
			self:_tween(self.Main, {Position = home}, FLIGHT_TIME * 0.7)
			self:_tween(self.WindowScale, {Scale = scale}, FLIGHT_TIME * 0.7)
		else
			local point = useOrb and self:_orbCenter() or self:_windowCenter(home, scale)
			self.Main.Position = spot(point)
			self.WindowScale.Scale = scale * FLIGHT_SCALE
			self.Main.Visible = true

			local delay = 0
			if not useOrb then
				local badge = self:_flightBadge(point)
				badge.Visible = true
				self.BadgeScale.Scale = 0.4
				self:_tween(self.BadgeScale, {Scale = 1}, 0.18, Enum.EasingStyle.Back)

				later(0.2, function()
					self:_tween(self.BadgeScale, {Scale = 0}, 0.22, Enum.EasingStyle.Back, Enum.EasingDirection.In)
				end)
				later(0.44, function()
					badge.Visible = false
				end)
				delay = 0.1
			end

			later(delay, function()
				self:_tween(self.Main, {Position = self.ShowingTo or home}, FLIGHT_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
				self:_tween(self.WindowScale, {Scale = scale}, FLIGHT_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
			end)
		end

		if useOrb and self.Orb.Visible then
			self:_tween(self.OrbScale, {Scale = 0.55}, 0.16)
			self:_effects(true)
			later(0.16, function()
				self:_effects()
				self.OrbScale.Scale = 1
			end)
		else
			self:_effects()
		end
		return
	end

	if not self.Main.Visible then
		self:_effects()
		return
	end

	local home = self.ShowingTo or self.Main.Position
	self.ShowingTo = nil
	self.HomePosition = home
	local point = useOrb and self:_orbCenter() or self:_windowCenter(home, scale)

	if useOrb then
		self.Orb.Visible = true
		self.OrbScale.Scale = 0.7
		self:_tween(self.OrbScale, {Scale = 1}, 0.24)
		later(FLIGHT_TIME * 0.9, function()
			self.OrbScale.Scale = 1.14
			self:_tween(self.OrbScale, {Scale = 1}, 0.32, Enum.EasingStyle.Back)
		end)
	else
		local badge = self:_flightBadge(point)
		badge.Visible = true
		self.BadgeScale.Scale = 0
		self:_tween(self.BadgeScale, {Scale = 1}, 0.26, Enum.EasingStyle.Back)

		later(FLIGHT_TIME + 0.04, function()
			self:_tween(self.BadgeScale, {Scale = 1.12}, 0.1)
		end)
		later(FLIGHT_TIME + 0.16, function()
			self:_tween(self.BadgeScale, {Scale = 0}, 0.24, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		end)
		later(FLIGHT_TIME + 0.42, function()
			badge.Visible = false
		end)
	end

	self:_tween(self.Main, {Position = spot(point)}, FLIGHT_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
	self:_tween(self.WindowScale, {Scale = scale * FLIGHT_SCALE}, FLIGHT_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
	later(FLIGHT_TIME, function()
		self.Main.Visible = false
	end)
	self:_effects(true)
end

function Window:_watchMenu()
	local stamps, openedAt = {}, nil

	self:_connect(GuiService.MenuOpened, function()
		openedAt = (not self.Visible and self.Settings.MenuReopen) and os.clock() or nil
	end)

	self:_connect(GuiService.MenuClosed, function()
		local opened = openedAt
		openedAt = nil
		if not opened or self.Visible or not self.Settings.MenuReopen then
			table.clear(stamps)
			return
		end

		local now = os.clock()
		table.insert(stamps, now)
		while #stamps > 0 and now - stamps[1] > 5 do
			table.remove(stamps, 1)
		end

		if #stamps >= 3 then
			table.clear(stamps)
			self:Show()
			self:Notify({
				Title = self.Title .. " reopened",
				Text = "You opened the Roblox menu 3 times in a row. If that was by accident, you can turn this shortcut off.",
				Kind = "info",
				Icon = "menu",
				Duration = 9,
				Action = {
					Text = "Turn off shortcut",
					Callback = function()
						if not self.Alive then
							return
						end
						self.Settings.MenuReopen = false
						self:_queueSave()
						self:_syncSetting("MenuReopen")
						self:Status("Roblox menu shortcut turned off. You can turn it back on in Settings.", "info")
					end
				}
			})
		end
	end)
end

function Window:_setupChat()
	local command = self.Options.ChatCommand
	if type(command) ~= "string" or command == "" then
		return
	end

	self.ChatCommandName = command:lower():gsub("^/e%s+", ""):gsub("^/", ""):gsub("%s+", "")
	self.ChatAlias = "/" .. self.ChatCommandName

	task.spawn(function()
		local ok, can = pcall(function()
			return game:GetService("TextChatService"):CanUserChatAsync(LocalPlayer.UserId)
		end)
		self.ChatChecked = true
		if self.Alive and ok and type(can) == "boolean" then
			self.ChatOK = can
		end
		if self.Alive then
			self:_refreshReopen()
		end
	end)
end

function Window:_chatCommandInstance(name)
	pcall(function()
		local service = game:GetService("TextChatService")
		local item = Lyra.Inst("TextChatCommand", {
			Name = "LyraUI_" .. name,
			PrimaryAlias = "/" .. name
		}, service)
		table.insert(self.ChatInstances, item)

		self:_on(item.Triggered, function(source, text)
			if not source or source.UserId == LocalPlayer.UserId then
				self:_chat(type(text) == "string" and text or ("/" .. name))
			end
		end)
	end)
end

function Window:_chat(message)
	if type(message) ~= "string" then
		return
	end
	local text = message:lower():gsub("^%s+", ""):gsub("%s+$", "")
	local body = text:match("^/e%s+(.+)$") or text:match("^/(.+)$")
	if not body then
		return
	end

	local name, rest = body:match("^(%S+)%s*(.*)$")
	if not name then
		return
	end

	local handler = name == self.ChatCommandName and "window" or self.Commands[name]
	if not handler then
		return
	end

	if self.LastChat == text and os.clock() - (self.LastChatAt or 0) < 1 then
		return
	end

	self.LastChat, self.LastChatAt = text, os.clock()
	if handler == "window" then
		self:Show()
	else
		self:_fire(handler, rest)
	end
end

function Window:Command(name, callback)
	name = tostring(name):lower():gsub("^/", "")
	self.Commands[name] = callback
	self:_chatCommandInstance(name)
end

function Window:_inputs()
	self:_watchMenu()

	self:_connect(UserInputService.InputBegan, function(input, processed)
		if self.Capture and input.UserInputType == Enum.UserInputType.Keyboard then
			local capture = self.Capture
			self.Capture = nil
			if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Unknown then
				capture.Cancel()
			else
				capture.Done(input.KeyCode.Name)
			end
			return
		end

		if processed or UserInputService:GetFocusedTextBox() or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end

		local key = input.KeyCode.Name
		if key == self.Settings.Keybind then
			self:Toggle()
		end

		for _, bind in ipairs(self.Keybinds) do
			if bind.Value == key and bind.Root.Parent then
				self:_fire(bind.Pressed, key)
			end
		end
	end)

	if self.ChatCommandName then
		self:_connect(LocalPlayer.Chatted, function(message)
			self:_chat(message)
		end)

		pcall(function()
			local service = game:GetService("TextChatService")
			pcall(function()
				local commands = service:FindFirstChild("TextChatCommands")
				local emote = commands and commands:FindFirstChild("RBXEmoteCommand")
				if emote then
					self:_connect(emote.Triggered, function(source, text)
						if (not source or source.UserId == LocalPlayer.UserId) and type(text) == "string" then
							self:_chat(text)
						end
					end)
				end
			end)

			self:_connect(service.MessageReceived, function(message)
				if message.TextSource and message.TextSource.UserId == LocalPlayer.UserId then
					self:_chat(message.Text)
				end
			end)
		end)

		self:_chatCommandInstance(self.ChatCommandName)
	end
end

function Window:Status(message, kind)
	kind = STATUS_KEYS[kind] and kind or "info"
	self.StatusText.Text = tostring(message or "")
	self:_paint(self.StatusText, {TextColor3 = STATUS_KEYS[kind]})
	self:_paint(self.StatusDot, {
		BackgroundColor3 = kind == "info" and "Accent" or STATUS_KEYS[kind]
	})
end

function Window:Notify(spec)
	if type(spec) == "string" then
		spec = {Title = spec}
	end
	if not self.Alive or (not self.Settings.Notifications and not spec.Force) then
		return nil
	end
	local ok, handle = pcall(function()
		return self.Toasts:Notify(spec)
	end)
	if not ok then
		warn("[Lyra UI] " .. tostring(handle))
		return nil
	end
	return handle
end

function Window:_buildModal()
	self.Modal = Lyra.Inst("Frame", {
		Name = "Dialog",
