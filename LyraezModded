THEME_KEYS = {
	"Base", "Card", "Raised", "Line", "Accent", "AccentDark",
	"Text", "Muted", "Green", "Red", "Gold", "Link", "SheenA", "SheenB",
	"ShineEnabled", "Shine", "StrokeShine", "StrokeDark", "ButtonGradient"
}

function Lyra.AddTheme(...)
	local name, colors = Lyra.Args(...)
	assert(type(name) == "string" and type(colors) == "table", "AddTheme needs (name, colors)")

	local fallback = Lyra.Themes.Lavender or colors
	local theme = {}

	for _, key in ipairs(THEME_KEYS) do
		theme[key] = colors[key] or fallback[key]
	end

	if not Lyra.Themes[name] then
		table.insert(Lyra.ThemeNames, name)
	end

	Lyra.Themes[name] = theme
	return theme
end

