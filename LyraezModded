	local openTitle = spec.OpenTitle or (spec.Title and spec.Title or "Hide advanced options")

	local holder = self:_add(Lyra.Inst("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1
	}, self.Frame))
	Lyra.ListLayout(holder, 6)

	local body = Lyra.Inst("Frame", {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = spec.Open == true
	}, holder)
	Lyra.ListLayout(body, spec.Gap or 6)

	local section = newContainer(window, body, self.Page)
	section.Root = holder

	local head = window:_button(holder, body.Visible and openTitle or closedTitle, false, function()
		section:SetOpen(not body.Visible)
	end, spec.Icon or "chevron-down")
	head.Root.LayoutOrder = 1
	section.Header = head

	function section:SetOpen(open)
		body.Visible = open == true
		head:SetText(body.Visible and openTitle or closedTitle)
		if head.Icon then
			head.Icon.Rotation = body.Visible and 180 or 0
		end
		window:_fire(spec.Callback, body.Visible)
	end

	function section:IsOpen()
		return body.Visible
	end

	if head.Icon then
		head.Icon.Rotation = body.Visible and 180 or 0
	end
	return section
end

function Container:Guide(spec)
	spec = spec or {}
	local window = self.Window
	local closedTitle = spec.Title or "How it works"
	local openTitle = spec.OpenTitle or ("Hide " .. closedTitle:sub(1, 1):lower() .. closedTitle:sub(2))

	local row = self:_add(Lyra.Inst("Frame", {
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1
	}, self.Frame))

	local label = Lyra.Inst("TextLabel", {
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		RichText = true,
		Text = "<u>" .. Lyra.Escape(closedTitle) .. "</u>",
		Font = Lyra.Font.Bold,
		TextSize = Lyra.TextSize(12),
		TextXAlignment = Enum.TextXAlignment.Left
	}, row)
	window:_paint(label, {TextColor3 = "Accent"})

	local chevrons = Lyra.Inst("Frame", {
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.new(0, 0, 0.5, -9),
		BackgroundTransparency = 1
	}, row)
	Lyra.Inst("UIScale", {Scale = 0.75}, chevrons)

	local down = window:_icon(chevrons, "chevron-down", UDim2.new(), "Accent")
	local up = window:_icon(chevrons, "chevron-up", UDim2.new(), "Accent")
	up.Visible = false

	local function place()
		chevrons.Position = UDim2.new(0, label.AbsoluteSize.X / (window.CurrentScale or 1) + 4, 0.5, -9)
	end
	window:_on(label:GetPropertyChangedSignal("AbsoluteSize"), place)
	task.defer(place)

	local hit = Lyra.Inst("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 3
	}, row)

	local card = self:_add(window:_autoCard(self.Frame, 6, 12))
	local lines = spec.Lines or {}
	for index, text in ipairs(lines) do
		window:_paragraph(card, text, 12, "Text").LayoutOrder = index
	end

	if spec.Note then
		window:_paragraph(card, spec.Note, 11, "Muted").LayoutOrder = #lines + 1
	end

	local open = spec.Open == true
	local object = element(card, {Row = row})

	local function refresh()
		card.Visible = open
		down.Visible = not open
		up.Visible = open
		label.Text = "<u>" .. Lyra.Escape(open and openTitle or closedTitle) .. "</u>"
		place()
	end

	function object:SetOpen(state)
		open = state == true
		refresh()
	end

	function object:IsOpen()
		return open
	end

	function object:Destroy()
		row:Destroy()
		card:Destroy()
	end

	window:_on(hit.Activated, function()
		object:SetOpen(not open)
	end)

	refresh()
	return object
end

