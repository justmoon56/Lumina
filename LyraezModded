function Toast:Notify(spec)
	if type(spec) == "string" then
		spec = {Title = spec}
	end
	assert(type(spec) == "table" and spec.Title, "Notify needs {Title = string}")

	local kind = self.Kinds[spec.Kind or "info"] and (spec.Kind or "info") or "info"
	local color, theme = self.Kinds[kind], self.Theme
	local duration = spec.Duration == nil and 4 or spec.Duration

	local featured = spec.Featured == true
	local parentWidth = self.Options.Parent.AbsoluteSize.X
	local wanted = featured and self.Width + 56 or self.Width
	local width = parentWidth > 0 and math.min(wanted, parentWidth - self.Margin * 2) or wanted

	self.Container.Size = UDim2.new(0, math.min(self.Width, width), 1, -(self.Margin * 2 + self.Lift))
	self.Order = self.Order + 1

	local title, text = tostring(spec.Title), spec.Text and tostring(spec.Text) or ""
	local badgeSize = featured and 40 or Toast.Badge
	local textLeft, textRight = 20 + badgeSize, 14
	local textWidth = math.max(60, width - textLeft - textRight)

	local function height(value, size, font)
		if value == "" then
			return 0
		end
		local ok, bounds = pcall(function()
			return TextService:GetTextSize(value, size, font, Vector2.new(textWidth, 10000))
		end)
		return ok and math.ceil(bounds.Y) or size + 4
	end

	local titleHeight = height(title, 13, self.Font.Bold)
	local textHeight = height(text, 12, self.Font.Regular)
	local action = type(spec.Action) == "table" and spec.Action or nil
	local actionHeight = action and 38 or 0
	local contentHeight = math.max(badgeSize, titleHeight + (textHeight > 0 and textHeight + 1 or 0) + actionHeight)
	local total = 10 + contentHeight + 11

	local holder = Lyra.Inst("Frame", {
		Name = "Toast",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(width, total),
		LayoutOrder = self.Order,
		ZIndex = 200
	}, self.Container)

	local card = Lyra.Inst("CanvasGroup", {
		BackgroundColor3 = theme.Background,
		BackgroundTransparency = 0.06,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(24, 0),
		GroupTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 200
	}, holder)
	Lyra.Round(card, 12)

	Lyra.Inst("UIStroke", {
		Color = featured and color or theme.Line,
		Transparency = featured and 0.25 or 0.4,
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	}, card)

	local wash = Lyra.Inst("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ZIndex = 200
	}, card)

	Lyra.Inst("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, featured and 0.7 or 0.84),
			NumberSequenceKeypoint.new(0.45, featured and 0.92 or 0.97),
			NumberSequenceKeypoint.new(1, 1)
		})
	}, wash)

	local badgeTop = featured and 10 or 10 + math.floor((contentHeight - badgeSize) / 2)
	local badge = Lyra.Inst("Frame", {
		Position = UDim2.fromOffset(10, badgeTop),
		Size = UDim2.fromOffset(badgeSize, badgeSize),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		ZIndex = 201
	}, card)
	Lyra.Round(badge, featured and 12 or 99)

	Lyra.Inst("UIStroke", {
		Color = color,
		Transparency = 0.55,
		Thickness = 1
	}, badge)

	local drew = false
	if type(spec.Image) == "string" and spec.Image ~= "" then
		local picture = Lyra.Inst("ImageLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Image = spec.Image,
			ScaleType = Enum.ScaleType.Crop,
			ZIndex = 202
		}, badge)
		Lyra.Round(picture, featured and 12 or 99)
		drew = true
	end

	if not drew and spec.Icon and type(self.Options.Icon) == "function" then
		local holderIcon = Lyra.Inst("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(24, 24),
			BackgroundTransparency = 1,
			ZIndex = 202
		}, badge)
		Lyra.Inst("UIScale", {Scale = featured and 1 or 0.62}, holderIcon)
		drew = pcall(self.Options.Icon, holderIcon, spec.Icon, UDim2.new(), color)
		if not drew then
			holderIcon:Destroy()
		end
	end

	if not drew then
		Toast.glyph(badge, Toast.KindGlyphs[kind], color)
	end

	local top = 10 + math.floor((contentHeight - titleHeight - (textHeight > 0 and textHeight + 1 or 0) - actionHeight) / 2)

	Lyra.Inst("TextLabel", {
		Position = UDim2.fromOffset(textLeft, top),
		Size = UDim2.fromOffset(textWidth, titleHeight),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = theme.Text,
		Font = self.Font.Bold,
		TextSize = 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 201
	}, card)

	if textHeight > 0 then
		Lyra.Inst("TextLabel", {
			Position = UDim2.fromOffset(textLeft, top + titleHeight + 1),
			Size = UDim2.fromOffset(textWidth, textHeight),
			BackgroundTransparency = 1,
			Text = text,
			TextColor3 = theme.Muted,
			Font = self.Font.Regular,
			TextSize = 12,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 201
		}, card)
	end

	local fill = Lyra.Inst("Frame", {
		Position = UDim2.new(0, 12, 1, -2),
		Size = UDim2.new(1, -24, 0, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		ZIndex = 202,
		Visible = duration > 0
	}, card)

	local hit = spec.Dismissible ~= false and Lyra.Inst("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 204
	}, card) or nil

	local actionButton
	if action then
		local label = tostring(action.Text or "Open")
		local bounds = Lyra.Measure(label, 13, self.Font.Bold, 1000)
		local buttonWidth = math.clamp(math.ceil(bounds.X) + 28, 90, math.max(90, textWidth))

		actionButton = Lyra.Inst("TextButton", {
			Position = UDim2.fromOffset(textLeft, top + titleHeight + (textHeight > 0 and textHeight + 1 or 0) + 8),
			Size = UDim2.fromOffset(buttonWidth, 30),
			BackgroundColor3 = color,
			Text = label,
			TextColor3 = theme.Background,
			Font = self.Font.Bold,
			TextSize = 13,
			AutoButtonColor = false,
			BorderSizePixel = 0,
			ZIndex = 205
		}, card)
		Lyra.Round(actionButton, 9)
	end

	local handle = {Closed = false}
	local notifier = self

	function handle:Dismiss()
		if handle.Closed then
			return
		end
		handle.Closed = true

		for i, item in ipairs(notifier.Active) do
			if item == handle then
				table.remove(notifier.Active, i)
				break
			end
		end

		if notifier:_reduced() then
			holder:Destroy()
			return
		end

		notifier:_tween(card, {
			GroupTransparency = 1,
			Position = UDim2.fromOffset(24, 0)
		}, 0.2)

		task.delay(0.22, function()
			if holder.Parent then
				holder:Destroy()
			end
		end)
	end

	if hit then
		hit.Activated:Connect(function()
			handle:Dismiss()
		end)
	end

	if actionButton then
		actionButton.Activated:Connect(function()
			handle:Dismiss()
			if type(action.Callback) == "function" then
				task.spawn(action.Callback)
			end
		end)
	end

	table.insert(self.Active, handle)
	while #self.Active > self.Max do
		self.Active[1]:Dismiss()
	end

	self:_tween(card, {
		GroupTransparency = 0,
		Position = UDim2.fromOffset(0, 0)
	}, 0.3)

	if duration > 0 then
		if not self:_reduced() then
			TweenService:Create(fill, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
				Size = UDim2.new(0, 0, 0, 1)
			}):Play()
		end
		task.delay(duration, function()
			handle:Dismiss()
		end)
	end

	return handle
end

function Toast:Clear()
	for i = #self.Active, 1, -1 do
		self.Active[i]:Dismiss()
	end
end

function Toast:Destroy()
	self.Active = {}
	if self.Container then
		self.Container:Destroy()
		self.Container = nil
	end
end

Lyra.Toast = Toast

