-- =============================================================================
-- GLOBAL LYRA FUNCTIONS (CONVERTED FROM LOCAL)
-- =============================================================================

function Lyra.Args(first, ...)
	if first == Lyra then
		return ...
	end
	return first, ...
end

function Lyra.Rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

function Lyra.Inst(class, props, parent)
	local item = Instance.new(class)
	for key, value in pairs(props or {}) do
		item[key] = value
	end
	if parent then
		item.Parent = parent
	end
	return item
end

function Lyra.Round(item, radius)
	return Lyra.Inst("UICorner", {
		CornerRadius = UDim.new(0, radius or 14)
	}, item)
end

function Lyra.Padding(item, top, right, bottom, left)
	return Lyra.Inst("UIPadding", {
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		PaddingLeft = UDim.new(0, left or 0)
	}, item)
end

function Lyra.ListLayout(item, gap, direction)
	return Lyra.Inst("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, gap or 8),
		FillDirection = direction or Enum.FillDirection.Vertical
	}, item)
end

function Lyra.TextSize(n)
	n = n or 14
	if n <= 10 then
		return 12
	elseif n <= 12 then
		return 13
	elseif n <= 13 then
		return 14
	end
	return n
end

function Lyra.Measure(text, size, font, width)
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(tostring(text), size, font, Vector2.new(width or 1000, 1000))
	end)
	return ok and bounds or Vector2.new(#tostring(text) * size * 0.55, size + 4)
end

function Lyra.Hex(color)
	return string.format(
		"#%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

function Lyra.IsPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

function Lyra.CopyText(text)
	local copy = (type(setclipboard) == "function" and setclipboard)
		or (type(toclipboard) == "function" and toclipboard)
		or nil
	if not copy then
		return false
	end
	return (pcall(copy, text))
end

function Lyra.NormalizeOptions(options)
	local result = {}
	for _, option in ipairs(options or {}) do
		if type(option) == "table" then
			local value = option.Value
			if value == nil then
				value = option.Label or option.Title or option[1]
			end
			table.insert(result, {
				Value = value,
				Label = tostring(option.Label or option.Title or option[1] or value),
				Icon = option.Icon
			})
		else
			table.insert(result, {
				Value = option,
				Label = tostring(option)
			})
		end
	end
	return result
end

function Lyra.LabelFor(options, value)
	for _, option in ipairs(options) do
		if option.Value == value then
			return option.Label
		end
	end
	return nil
end

function Lyra.Initials(text)
	local letters = ""
	for word in tostring(text):gmatch("%w+") do
		letters = letters .. word:sub(1, 1):upper()
		if #letters >= 2 then
			break
		end
	end
	return letters ~= "" and letters or "UI"
end

function Lyra.ResolveTheme(value)
	if type(value) == "string" and Lyra.Themes[value] then
		return Lyra.Themes[value], value
	end
	if type(value) == "table" then
		local base = Lyra.Themes[value.Extends or "Lavender"] or Lyra.Themes.Lavender
		local theme = {}
		for _, key in ipairs(THEME_KEYS) do
			theme[key] = value[key] or base[key]
		end
		return theme, nil
	end
	return Lyra.Themes.Lavender, "Lavender"
end

function Lyra.RunHooks(hooks, ...)
	for i = #hooks, 1, -1 do
		if hooks[i].Root.Parent == nil then
			table.remove(hooks, i)
		end
	end
	for _, hook in ipairs(hooks) do
		local ok, problem = pcall(hook.Fn, ...)
		if not ok then
			warn("[Lyra UI] " .. tostring(problem))
		end
	end
end

function Lyra.Spread(items, gap)
	local count = #items
	for index, item in ipairs(items) do
		item.Position = UDim2.new((index - 1) / count, math.floor((index - 1) * gap / count), 0, 0)
		item.Size = UDim2.new(1 / count, -math.floor((count - 1) * gap / count), 1, 0)
	end
end

function Lyra.Decimals(step)
	local text = tostring(step)
	local dot = text:find("%.")
	return dot and math.min(6, #text - dot) or 0
end

function Lyra.Snap(value, step, min)
	local snapped = min + math.floor((value - min) / step + 0.5) * step
	return tonumber(string.format("%." .. Lyra.Decimals(step) .. "f", snapped))
end

function Lyra.Escape(text)
	return (tostring(text):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

function Lyra.StepValues(spec)
	if type(spec.Values) == "table" and #spec.Values > 0 then
		return spec.Values
	end
	local min, max, step = tonumber(spec.Min) or 0, tonumber(spec.Max) or 10, tonumber(spec.Step) or 1
	if step <= 0 then
		step = 1
	end
	local values = {}
	for i = 0, math.clamp(math.floor((max - min) / step + 0.5), 0, 1000) do
		table.insert(values, Lyra.Snap(min + i * step, step, min))
	end
	return values
end

-- =============================================================================
-- ANIMATION / SHINE SYSTEM (FLUENT STYLE)
-- =============================================================================
local Animation
do
	local _RunService = game:GetService("RunService")
	local _conns = {}
	Animation = {}
	function Animation.Apply(theme, root)
		for _, c in ipairs(_conns) do pcall(function() c:Disconnect() end) end
		table.clear(_conns)
		if not theme or not root or not getgenv().ShineEnabled or not theme.ShineEnabled or not theme.Shine then return end
		local ShineConfig   = theme.Shine
		local Speed         = ShineConfig.Speed         or 0.5
		local RotationSpeed = ShineConfig.RotationSpeed or 25
		local ColorSeq      = ShineConfig.ColorSequence
		for _, obj in ipairs(root:GetDescendants()) do
			if obj:IsA("UIGradient") then
				local conn
				conn = _RunService.RenderStepped:Connect(function(dt)
					local t = (obj:GetAttribute("_t") or 0) + dt * Speed
					obj:SetAttribute("_t", t)
					obj.Rotation = (t * RotationSpeed) % 360
					obj.Color    = ColorSeq
				end)
				table.insert(_conns, conn)
			end
			if obj:IsA("UIStroke") and theme.StrokeShine then
				local from  = theme.StrokeDark or theme.Line
				local shine = theme.Accent
				local conn
				conn = _RunService.RenderStepped:Connect(function(dt)
					local t = (obj:GetAttribute("_t") or 0) + dt * Speed
					obj:SetAttribute("_t", t)
					obj.Thickness = 2
					obj.Color     = from:Lerp(shine, (math.sin(t) + 1) / 2)
				end)
				table.insert(_conns, conn)
			end
		end
	end
end
if not Animation then Animation = {Apply = function() end} end
getgenv().ShineEnabled = getgenv().ShineEnabled ~= nil and getgenv().ShineEnabled or true
