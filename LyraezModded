function Container:List(spec)
	spec = spec or {}
	local window, container = self.Window, self
	local frame = self:_add(Lyra.Inst("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1
	}, self.Frame))
	Lyra.ListLayout(frame, 6)

	local reorder = spec.Reorderable == true or type(spec.OnReorder) == "function"
	local object = element(frame, {Items = {}, Rows = {}})
	local emptyCard
	local startDrag

	local function addRow(item, index)
		if emptyCard then
			emptyCard:Destroy()
			emptyCard = nil
		end
		local row = window:_row(frame, item, reorder and index or nil)
		row.Root.LayoutOrder = index
		row.Index = index
		if reorder then
			local grip = Lyra.Inst("TextButton", {
				Size = UDim2.new(0, 92, 1, 0),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				BorderSizePixel = 0
			}, row.Root)
			window:_on(grip.InputBegan, function(input)
				if Lyra.IsPointer(input) then
					startDrag(row.Index, row.Root, input)
				end
			end)
		end
		table.insert(object.Rows, row)
		return row
	end

	local function render()
		for _, row in ipairs(object.Rows) do
			row.Root:Destroy()
		end
		object.Rows = {}
		if emptyCard then
			emptyCard:Destroy()
			emptyCard = nil
		end
		for index, item in ipairs(object.Items) do
			addRow(item, index)
		end
		if #object.Items == 0 and spec.Empty ~= false then
			emptyCard = window:_empty(frame, spec.EmptyTitle or "Nothing here yet", spec.EmptyText or "Items you add will appear here.", spec.EmptyIcon)
		end
	end

	function startDrag(index, row, input)
		if object.Dragging or #object.Items < 2 then
			return
		end
		local touch = input.UserInputType == Enum.UserInputType.Touch and input or nil
		local drag = {From = index, Slot = nil, Connections = {}}
		object.Dragging = drag

		local page = container.Page
		if page then
			page.ScrollingEnabled = false
		end

		local stroke = row:FindFirstChildOfClass("UIStroke")
		if stroke then
			window:_paint(stroke, {Color = "Accent"})
			stroke.Transparency = 0
		end
		row.BackgroundTransparency = 0.55

		local width = frame.AbsoluteSize.X
		drag.Line = Lyra.Inst("Frame", {
			Size = UDim2.fromOffset(width, 3),
			BorderSizePixel = 0,
			ZIndex = 40
		}, window.Surface)
		window:_paint(drag.Line, {BackgroundColor3 = "Accent"})
		Lyra.Round(drag.Line, 2)

		drag.Ghost = Lyra.Inst("TextLabel", {
			Size = UDim2.fromOffset(math.max(120, math.min(260, width - 24)), 36),
			BackgroundTransparency = 0.05,
			Text = "  " .. tostring(object.Items[index].Title or ""),
			Font = Lyra.Font.Bold,
			TextSize = Lyra.TextSize(13),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 41,
			BorderSizePixel = 0
		}, window.Surface)
		window:_paint(drag.Ghost, {BackgroundColor3 = "AccentDark", TextColor3 = "Text"})
		Lyra.Round(drag.Ghost, 10)
		window:_stroke(drag.Ghost, 0.2, "Accent")

		local function update(y)
			local top, surface = frame.AbsolutePosition.Y, window.Surface.AbsolutePosition
			local step = 64 * (window.CurrentScale or 1)
			drag.Slot = math.clamp(math.floor((y - top) / step + 0.5), 0, #object.Items)
			drag.Line.Position = UDim2.fromOffset(frame.AbsolutePosition.X - surface.X, top + drag.Slot * step - 4 - surface.Y)
			drag.Ghost.Position = UDim2.fromOffset(frame.AbsolutePosition.X - surface.X + 12, y - 18 - surface.Y)
			if page then
				local pageTop = page.AbsolutePosition.Y
				local pageBottom = pageTop + page.AbsoluteSize.Y
				if y < pageTop + 48 then
					page.CanvasPosition = Vector2.new(0, math.max(0, page.CanvasPosition.Y - 14))
				elseif y > pageBottom - 48 then
					page.CanvasPosition = Vector2.new(0, page.CanvasPosition.Y + 14)
				end
			end
		end

		local function finish()
			for _, connection in ipairs(drag.Connections) do
				connection:Disconnect()
			end
			object.Dragging = nil
			pcall(function()
				drag.Line:Destroy()
				drag.Ghost:Destroy()
			end)
			if page then
				page.ScrollingEnabled = true
			end
			if not window.Alive then
				return
			end
			if drag.Slot then
				local target = math.clamp(drag.Slot >= drag.From and drag.Slot or drag.Slot + 1, 1, #object.Items)
				if target ~= drag.From then
					table.insert(object.Items, target, table.remove(object.Items, drag.From))
					render()
					window:_fire(spec.OnReorder, drag.From, target, object.Items)
					return
				end
			end
			render()
		end

		table.insert(drag.Connections, UserInputService.InputChanged:Connect(function(changed)
			if touch and changed ~= touch then
				return
			end
			if not touch and changed.UserInputType ~= Enum.UserInputType.MouseMovement then
				return
			end
			if window.Alive then
				update(changed.Position.Y)
			end
		end))

		table.insert(drag.Connections, UserInputService.InputEnded:Connect(function(ended)
			if (touch and ended == touch) or (not touch and ended.UserInputType == Enum.UserInputType.MouseButton1) then
				finish()
			end
		end))
		update(input.Position.Y)
	end

	function object:Add(item)
		table.insert(object.Items, item)
		return addRow(item, #object.Items)
	end

	function object:Remove(index)
		if type(index) == "table" then
			index = table.find(object.Items, index)
		end
		if index and object.Items[index] then
			table.remove(object.Items, index)
			render()
		end
	end

	function object:Set(items)
		object.Items = {}
		for _, item in ipairs(items or {}) do
			table.insert(object.Items, item)
		end
		render()
	end

	function object:Get()
		return object.Items
	end

	function object:Clear()
		object:Set({})
	end

	function object:Refresh()
		render()
	end

	object:Set(spec.Items)
	return object
end

function Container:Grid(spec)
	spec = spec or {}
	local window = self.Window
	local cellHeight, minCell = spec.CellHeight or 200, spec.MinWidth or 150
	local frame = self:_add(Lyra.Inst("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1
	}, self.Frame))
	local layout = Lyra.Inst("UIGridLayout", {
		CellSize = UDim2.fromOffset(minCell, cellHeight),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder
	}, frame)
	local object = element(frame, {Cards = {}, Count = 0})

	local function columns()
		local scale = window.WindowScale.Scale > 0 and window.WindowScale.Scale or 1
		local width = math.floor(frame.AbsoluteSize.X / scale)
		if width <= 0 then
			return
		end
		local count = math.clamp(math.floor((width + 8) / (minCell + 8)), spec.MinColumns or 2, spec.MaxColumns or 6)
		layout.FillDirectionMaxCells = count
		layout.CellSize = UDim2.fromOffset(math.floor((width - 8 * (count - 1)) / count), cellHeight)
	end

	window:_on(frame:GetPropertyChangedSignal("AbsoluteSize"), columns)

	function object:Add(item)
		item = item or {}
		object.Count = object.Count + 1
		local card = Lyra.Inst("Frame", {
			LayoutOrder = object.Count,
			BackgroundTransparency = 0.22,
			BorderSizePixel = 0
		}, frame)
		window:_paint(card, {BackgroundColor3 = "Card"})
		Lyra.Round(card, 14)
		window:_stroke(card, 0.55)

		local thumb = Lyra.Inst("TextButton", {
			Position = UDim2.fromOffset(8, 8),
			Size = UDim2.new(1, -16, 0, 96),
			Text = "",
			AutoButtonColor = false,
			BorderSizePixel = 0,
			ClipsDescendants = true
		}, card)
		window:_paint(thumb, {BackgroundColor3 = "Raised"})
		Lyra.Round(thumb, 10)

		local picture = Lyra.Inst("ImageLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScaleType = Enum.ScaleType.Fit,
			Image = tostring(item.Image or "")
		}, thumb)

		if not item.Image and item.Icon then
			local icon = window:_icon(thumb, item.Icon, UDim2.new(0.5, -12, 0.5, -12), "AccentDark")
			Lyra.Inst("UIScale", {Scale = 1.6}, icon)
		end

		if item.Tag then
			local tag = window:_text(thumb, tostring(item.Tag), 9, "Base", true)
			tag.AutomaticSize = Enum.AutomaticSize.X
			tag.Size = UDim2.fromOffset(0, 18)
			tag.Position = UDim2.fromOffset(6, 6)
			tag.BackgroundTransparency = 0
			window:_paint(tag, {BackgroundColor3 = "Accent"})
			Lyra.Round(tag, 9)
			Lyra.Padding(tag, 0, 7, 0, 7)
		end

		local check = Lyra.Inst("Frame", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(24, 24),
			BorderSizePixel = 0,
			Visible = item.Checked == true
		}, thumb)
		window:_paint(check, {BackgroundColor3 = "Green"})
		Lyra.Round(check, 12)
		Toast.glyph(check, "check", window.Theme.Base)

		local name = window:_text(card, item.Title or "", 12, "Text", true)
		name.Position = UDim2.fromOffset(10, 110)
		name.Size = UDim2.new(1, -20, 0, 32)
		name.TextWrapped = true
		name.TextYAlignment = Enum.TextYAlignment.Top

		local caption = window:_text(card, item.Caption or "", 10, "Muted")
		caption.Position = UDim2.fromOffset(10, 142)
		caption.Size = UDim2.new(1, -20, 0, 16)

		local entry = element(card, {Item = item, Picture = picture})
		if item.Button ~= false then
			local buttonSpec = type(item.Button) == "table" and item.Button or {Title = type(item.Button) == "string" and item.Button or "Select"}
			local button = window:_button(card, buttonSpec.Title or "Select", buttonSpec.Primary ~= false, function()
				local callback = buttonSpec.Callback or item.Callback
				if type(callback) == "function" then
					callback(item, entry)
				end
			end, buttonSpec.Icon)
			button.Root.Position = UDim2.new(0, 8, 1, -42)
			button.Root.Size = UDim2.new(1, -16, 0, 34)
			entry.Button = button
		end

		if item.OnClick or item.Callback then
			window:_on(thumb.Activated, function()
				window:_fire(item.OnClick or item.Callback, item, entry)
			end)
		end

		function entry:SetChecked(on)
			check.Visible = on == true
		end
		function entry:SetCaption(text)
			caption.Text = tostring(text or "")
		end
		function entry:SetTitle(text)
			name.Text = tostring(text or "")
		end

		table.insert(object.Cards, entry)
		columns()
		return entry
	end

	function object:Clear()
		for _, entry in ipairs(object.Cards) do
			entry.Root:Destroy()
		end
		object.Cards, object.Count = {}, 0
	end

	function object:Set(items)
		object:Clear()
		for _, item in ipairs(items or {}) do
			object:Add(item)
		end
	end

	object:Set(spec.Items)
	task.defer(columns)
	return object
end

function Container:Preview(spec)
	spec = spec or {}
	local window, container = self.Window, self
	local card = self:_add(window:_card(self.Frame, spec.Height or 300))
	window:_gradient(card, "Raised", "Card", 60)

	local tag = window:_text(card, spec.Title or "3D PREVIEW", 10, "Accent", true)
	tag.Position = UDim2.fromOffset(16, 13)
	tag.Size = UDim2.new(1, -32, 0, 16)

	local viewport = Lyra.Inst("ViewportFrame", {
		Position = UDim2.fromOffset(8, 32),
		Size = UDim2.new(1, -16, 1, -87),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(195, 186, 213),
		LightColor = Color3.fromRGB(255, 244, 233),
		LightDirection = Vector3.new(-1, -1, -1),
		Active = true,
		Visible = false
	}, card)

	local fallback = Lyra.Inst("ImageLabel", {
		Position = UDim2.fromOffset(8, 30),
		Size = UDim2.new(1, -16, 1, -90),
		BackgroundTransparency = 1,
		Image = "",
		ScaleType = Enum.ScaleType.Fit,
		Visible = false
	}, card)

	local world = Lyra.Inst("WorldModel", {}, viewport)
	local camera = Lyra.Inst("Camera", {FieldOfView = 35}, viewport)
	viewport.CurrentCamera = camera

	local empty = Lyra.Inst("Frame", {
		Position = UDim2.fromOffset(8, 40),
		Size = UDim2.new(1, -16, 1, -106),
		BackgroundTransparency = 1
	}, card)

	local motif = window:_icon(empty, spec.Icon or "user", UDim2.new(0.5, -12, 0.5, -48), "AccentDark")
	Lyra.Inst("UIScale", {Scale = 1.5}, motif)

	local defaultHint = spec.Hint or "Nothing to preview yet."
	local hint = window:_text(empty, defaultHint, 13, "Muted")
	hint.Position = UDim2.new(0, 12, 0.5, 10)
	hint.Size = UDim2.new(1, -24, 0, 42)
	hint.TextWrapped = true
	hint.TextTruncate = Enum.TextTruncate.None
	hint.TextXAlignment = Enum.TextXAlignment.Center

	local bar = Lyra.Inst("Frame", {
		Position = UDim2.new(0.2, 0, 0.5, 61),
		Size = UDim2.new(0.6, 0, 0, 3),
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		Visible = false
	}, empty)
	window:_paint(bar, {BackgroundColor3 = "AccentDark"})
	Lyra.Round(bar, 4)

	local fill = Lyra.Inst("Frame", {
		Size = UDim2.new(0.2, 0, 1, 0),
		BorderSizePixel = 0
	}, bar)
	window:_paint(fill, {BackgroundColor3 = "Accent"})
	Lyra.Round(fill, 4)

	local controls = Lyra.Inst("Frame", {
		Position = UDim2.new(0, 12, 1, -49),
		Size = UDim2.new(1, -24, 0, 38),
		BackgroundTransparency = 1
	}, card)

	local object = element(card, {
		Viewport = viewport,
		World = world,
		Camera = camera,
		Rotation = 0,
		Pitch = 0.05,
		Zoom = 1
	})

	local function aim(immediate)
		if not object.Bounds then
			return
		end
		local bounds, size = object.Bounds, viewport.AbsoluteSize
		local aspect = math.max(0.3, size.X / math.max(1, size.Y))
		local distance = (math.max(bounds.Y, bounds.X / aspect) * 0.5 / math.tan(math.rad(camera.FieldOfView / 2)) + bounds.Z * 0.5) * 1.18 * object.Zoom
		local offset = Vector3.new(math.sin(object.Rotation) * math.cos(object.Pitch), math.sin(object.Pitch), -math.cos(object.Rotation) * math.cos(object.Pitch)) * distance
		window:_tween(camera, {CFrame = CFrame.lookAt(object.Center + offset, object.Center)}, immediate and 0 or 0.16)
	end

	local zoomOut = window:_button(controls, "", false, function()
		object.Zoom = math.clamp(object.Zoom * 1.14, 0.55, 1.8)
		aim()
	end, "minus")
	zoomOut.Root.Size = UDim2.fromOffset(38, 38)

	local zoomIn = window:_button(controls, "", false, function()
		object.Zoom = math.clamp(object.Zoom / 1.14, 0.55, 1.8)
		aim()
	end, "plus")
	zoomIn.Root.Size = UDim2.fromOffset(38, 38)
	zoomIn.Root.Position = UDim2.fromOffset(44, 0)

	local reset = window:_button(controls, "", false, function()
		object.Rotation, object.Pitch, object.Zoom = 0, 0.05, 1
		aim()
	end, "reset")
	reset.Root.Size = UDim2.fromOffset(38, 38)
	reset.Root.Position = UDim2.fromOffset(88, 0)

	local dragHint = window:_text(controls, spec.ControlsHint or "Drag to rotate", 10, "Muted")
	dragHint.Position = UDim2.fromOffset(134, 0)
	dragHint.Size = UDim2.new(1, -138, 1, 0)
	dragHint.TextWrapped = true

	local generation = 0
	function object:Loading(on, message)
		on = on == true
		bar.Visible = on
		if message then
			hint.Text = tostring(message)
		end
		if on then
			empty.Visible = true
			motif.Visible = true
			viewport.Visible = false
			fallback.Visible = false
		end
		generation = generation + 1
		local mine = generation
		if on and not window.Settings.ReducedMotion and not window.Settings.LowEffects then
			task.spawn(function()
				while window.Alive and mine == generation and bar.Visible and bar.Parent do
					fill.Position = UDim2.new()
					window:_tween(fill, {Position = UDim2.new(0.8, 0, 0, 0)}, 0.65)
					task.wait(0.7)
				end
			end)
		end
	end

	function object:SetModel(model, keepView)
		assert(typeof(model) == "Instance" and model:IsA("Model"), "SetModel needs a Model")
		if object.Model and object.Model ~= model then
			object.Model:Destroy()
		end
		object.Model = model
		if spec.Anchor ~= false then
			for _, part in ipairs(model:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Anchored = true
				end
			end
		end
		model.Parent = world
		local center, size = model:GetBoundingBox()
		object.Center, object.Bounds = center.Position, size
		if not keepView then
			object.Rotation, object.Pitch, object.Zoom = 0, 0.05, 1
		end
		object:Loading(false)
		empty.Visible, fallback.Visible, viewport.Visible = false, false, true
		aim(true)
	end

	function object:SetImage(image, message)
		object:Loading(false, message or "")
		fallback.Image = tostring(image or "")
		fallback.Visible, viewport.Visible = true, false
		empty.Visible, motif.Visible = message ~= nil, false
	end

	function object:Clear(message)
		if object.Model then
			object.Model:Destroy()
			object.Model = nil
		end
		object.Bounds = nil
		object:Loading(false, message or defaultHint)
		empty.Visible, motif.Visible, viewport.Visible, fallback.Visible = true, true, false, false
	end

	function object:SetTitle(text)
		tag.Text = tostring(text or "")
	end

	local dragging, last, touch
	window:_on(viewport.InputBegan, function(input)
		if not Lyra.IsPointer(input) then
			return
		end
		dragging = true
		last = Vector2.new(input.Position.X, input.Position.Y)
		touch = input.UserInputType == Enum.UserInputType.Touch and input or nil
		if container.Page then
			container.Page.ScrollingEnabled = false
		end
	end)

	window:_connect(UserInputService.InputChanged, function(input)
		if not dragging or (touch and input ~= touch) or (not touch and input.UserInputType ~= Enum.UserInputType.MouseMovement) then
			return
		end
		local position = Vector2.new(input.Position.X, input.Position.Y)
		local delta = position - last
		last = position
		object.Rotation = object.Rotation - delta.X * 0.012
		object.Pitch = math.clamp(object.Pitch + delta.Y * 0.006, -0.35, 0.6)
		aim(true)
	end)

	window:_connect(UserInputService.InputEnded, function(input)
		if dragging and ((touch and input == touch) or (not touch and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			dragging = false
			touch = nil
			if container.Page then
				container.Page.ScrollingEnabled = true
			end
		end
	end)

	window:_on(viewport.InputChanged, function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			object.Zoom = math.clamp(object.Zoom * (input.Position.Z > 0 and 0.9 or 1.1), 0.55, 1.8)
			aim()
		end
	end)

	window:_on(viewport:GetPropertyChangedSignal("AbsoluteSize"), function()
		aim(true)
	end)
	return object
end

function Container:Strip(spec)
	spec = spec or {}
	local window = self.Window
	local buttons = spec.Buttons or {}
	local card = self:_add(window:_card(self.Frame, #buttons > 0 and 156 or 112))
	window:_icon(card, spec.Icon or "history", UDim2.fromOffset(12, 9), "Accent")

	local title = window:_text(card, spec.Title or "Timeline", 13, "Text", true)
	title.Position = UDim2.fromOffset(42, 9)
	title.Size = UDim2.new(0.5, -42, 0, 24)

	local hint = window:_text(card, spec.Hint or "", 11, "Muted")
	hint.Position = UDim2.new(0.5, 0, 0, 9)
	hint.Size = UDim2.new(0.5, -14, 0, 24)
	hint.TextXAlignment = Enum.TextXAlignment.Right

	local strip = Lyra.Inst("ScrollingFrame", {
		Position = UDim2.fromOffset(8, 40),
		Size = UDim2.new(1, -16, 0, 66),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollingDirection = Enum.ScrollingDirection.X,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ElasticBehavior = Enum.ElasticBehavior.Never
	}, card)
	window:_paint(strip, {ScrollBarImageColor3 = "AccentDark"})
	Lyra.ListLayout(strip, 4, Enum.FillDirection.Horizontal)

	local object = element(card, {Strip = strip, Buttons = {}})
	if #buttons > 0 then
		local row = Lyra.Inst("Frame", {
			Position = UDim2.new(0, 10, 1, -46),
			Size = UDim2.new(1, -20, 0, 36),
			BackgroundTransparency = 1
		}, card)
		local roots = {}
		for _, buttonSpec in ipairs(buttons) do
			local button = window:_button(row, buttonSpec.Title or "", buttonSpec.Primary, buttonSpec.Callback, buttonSpec.Icon)
			table.insert(object.Buttons, button)
			table.insert(roots, button.Root)
		end
		Lyra.Spread(roots, 8)
		window:_onLayout(card, function(state)
			for _, button in ipairs(object.Buttons) do
				if button.Label.Text ~= "" then
					button:SetIconVisible(not state.Compact)
				end
			end
		end)
	end

	function object:Set(items)
		for _, child in ipairs(strip:GetChildren()) do
			if not child:IsA("UIListLayout") then
				child:Destroy()
			end
		end
		items = items or {}
		if #items == 0 then
			local emptyText = window:_text(strip, spec.Empty or "Nothing here yet.", 11, "Muted")
			emptyText.Size = UDim2.fromScale(1, 1)
			return
		end
		for index, item in ipairs(items) do
			local tile = Lyra.Inst("TextButton", {
				LayoutOrder = index,
				Size = UDim2.fromOffset(58, 64),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				BorderSizePixel = 0
			}, strip)

			local frame = Lyra.Inst("Frame", {
				Position = UDim2.fromOffset(7, 0),
				Size = UDim2.fromOffset(44, 44),
				BorderSizePixel = 0,
				ClipsDescendants = true
			}, tile)
			window:_paint(frame, {BackgroundColor3 = "Raised"})
			Lyra.Round(frame, 12)
			window:_stroke(frame, item.Current and 0 or 0.6, item.Current and "Accent" or "Line").Thickness = item.Current and 2 or 1

			if item.Image then
				Lyra.Inst("ImageLabel", {
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Image = tostring(item.Image),
					ScaleType = Enum.ScaleType.Crop
				}, frame)
			else
				window:_icon(frame, item.Icon or "user", UDim2.new(0.5, -12, 0.5, -12), "AccentDark")
			end

			local label = window:_text(tile, item.Label or "", 10, item.Current and "Accent" or "Muted", item.Current)
			label.Position = UDim2.fromOffset(0, 46)
			label.Size = UDim2.new(1, 0, 0, 18)
			label.TextXAlignment = Enum.TextXAlignment.Center

			if not item.Current and item.Callback then
				window:_on(tile.Activated, function()
					window:_fire(item.Callback, item)
				end)
				window:_on(tile.MouseEnter, function()
					window:_tint(frame, {BackgroundColor3 = "AccentDark"})
				end)
				window:_on(tile.MouseLeave, function()
					window:_tint(frame, {BackgroundColor3 = "Raised"})
				end)
			end
		end

		if spec.ScrollToEnd ~= false then
			task.defer(function()
				if strip.Parent then
					strip.CanvasPosition = Vector2.new(math.max(0, strip.AbsoluteCanvasSize.X - strip.AbsoluteWindowSize.X), 0)
				end
			end)
		end
	end

	function object:SetHint(text)
		hint.Text = tostring(text or "")
	end

	object:Set(spec.Items)
	return object
end

function Window:_linkBlock(card, order, label, url)
	local holder = Lyra.Inst("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1
	}, card)

	local link = Lyra.Inst("TextButton", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		RichText = true,
		Text = "",
		TextSize = Lyra.TextSize(13),
		Font = Lyra.Font.Regular,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top
	}, holder)

	self:_onTheme(link, function()
		link.Text = '<u><font color="' .. Lyra.Hex(self.Theme.Link) .. '">' .. Lyra.Escape(url) .. "</font></u>"
		link.TextColor3 = self.Theme.Link
	end)

	local fallback = Lyra.Inst("TextBox", {
		Visible = false,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Text = url,
		TextEditable = false,
		ClearTextOnFocus = false,
		TextSize = Lyra.TextSize(13),
		Font = Lyra.Font.Regular,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top
	}, holder)
	self:_paint(fallback, {TextColor3 = "Link"})

	local button
	local function copy()
		if Lyra.CopyText(url) then
			button:SetText("Copied!")
			self:Status(label .. " link copied.", "success")
			task.delay(1.5, function()
				if self.Alive and button.Root.Parent then
					button:SetText("Copy link")
				end
			end)
			return
		end
		link.Visible, fallback.Visible = false, true
		fallback:CaptureFocus()
		fallback.SelectionStart = 1
		fallback.CursorPosition = #url + 1
		self:Status("Automatic clipboard access is unavailable. Select the link and copy it manually.", "warning")
	end

	button = self:_button(card, "Copy link", false, copy, "copy")
	button.Root.LayoutOrder = order + 1
	self:_on(link.Activated, copy)
	self:_on(fallback.FocusLost, function()
		fallback.Visible, link.Visible = false, true
	end)
	return button
end

