		BackgroundTransparency = 0.3,
		ZIndex = 50,
		Visible = false,
		Active = true
	}, self.Main)

	local card = Lyra.Inst("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -48, 0, 224),
		BorderSizePixel = 0
	}, self.Modal)
	self:_paint(card, {BackgroundColor3 = "Card"})
	Lyra.Round(card, 18)
	self:_stroke(card, 0.1)
	Lyra.Inst("UISizeConstraint", {MaxSize = Vector2.new(440, 224)}, card)

	self.ModalTitle = self:_text(card, "", 18, "Text", true)
	self.ModalTitle.Position = UDim2.fromOffset(18, 20)
	self.ModalTitle.Size = UDim2.new(1, -36, 0, 28)

	self.ModalText = self:_text(card, "", 12, "Muted")
	self.ModalText.Position = UDim2.fromOffset(18, 61)
	self.ModalText.Size = UDim2.new(1, -36, 0, 88)
	self.ModalText.TextWrapped = true
	self.ModalText.TextTruncate = Enum.TextTruncate.None
	self.ModalText.TextYAlignment = Enum.TextYAlignment.Top

	local function finish(confirmed)
		self.ModalToken = (self.ModalToken or 0) + 1
		self.Modal.Visible = false
		local action = confirmed and self.ModalAction or self.ModalCancelAction
		self.ModalAction, self.ModalCancelAction = nil, nil
		self:_fire(action)
	end

	self.ModalCancel = self:_button(card, "Cancel", false, function()
		finish(false)
	end)
	self.ModalCancel.Root.Position = UDim2.new(0, 16, 1, -60)
	self.ModalCancel.Root.Size = UDim2.new(0.5, -22, 0, 44)

	self.ModalConfirm = self:_button(card, "Confirm", true, function()
		finish(true)
	end)
	self.ModalConfirm.Root.Position = UDim2.new(0.5, 6, 1, -60)
	self.ModalConfirm.Root.Size = UDim2.new(0.5, -22, 0, 44)
end

function Window:Confirm(spec, text, callback)
	if type(spec) ~= "table" then
		spec = {Title = spec, Text = text, Callback = callback}
	end

	self.ModalToken = (self.ModalToken or 0) + 1
	local token = self.ModalToken

	self.ModalTitle.Text = tostring(spec.Title or "Are you sure?")
	self.ModalText.Text = tostring(spec.Text or spec.Description or "")
	self.ModalAction, self.ModalCancelAction = spec.Callback, spec.OnCancel

	local cancelText = tostring(spec.Cancel or "Cancel")
	self.ModalConfirm:SetText(spec.Confirm or "Confirm")
	self.ModalCancel:SetText(cancelText)

	self:_closeDropdown(true)
	self.Modal.Visible = true

	if not spec.Seconds then
		return
	end

	task.spawn(function()
		for left = spec.Seconds, 1, -1 do
			if not self.Alive or token ~= self.ModalToken then
				return
			end
			self.ModalCancel:SetText(cancelText .. " (" .. tostring(left) .. ")")
			task.wait(1)
		end

		if self.Alive and token == self.ModalToken then
			self.ModalToken = token + 1
			self.Modal.Visible = false
			local action = self.ModalCancelAction
			self.ModalAction, self.ModalCancelAction = nil, nil
			self.ModalCancel:SetText(cancelText)
			self:_fire(action)
		end
	end)
end

function Window:_dropdown(parent, options, get, set, placeholder)
	local button = Lyra.Inst("TextButton", {
		Size = UDim2.new(1, 0, 0, 40),
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0
	}, parent)
	self:_paint(button, {BackgroundColor3 = "Raised"})
	Lyra.Round(button, 12)

	local stroke = self:_stroke(button, 0.6)
	local label = self:_text(button, "", 12, "Text", true)
	label.Position = UDim2.fromOffset(12, 0)
	label.Size = UDim2.new(1, -42, 1, 0)

	local chevron = self:_icon(button, "chevron-down", UDim2.new(1, -32, 0.5, -12), "Accent")

	local drop = {
		Root = button,
		Label = label,
		Options = options,
		Get = get,
		Set = set,
		Chevron = chevron,
		Stroke = stroke
	}

	function drop.refresh()
		label.Text = Lyra.LabelFor(drop.Options, get()) or placeholder or "Select…"
	end

	self:_on(button.Activated, function()
		if self.OpenDrop == drop then
			self:_closeDropdown()
		else
			self:_openDropdown(drop)
		end
	end)

	self:_on(button.MouseEnter, function()
		self:_tween(button, {
			BackgroundColor3 = self.Theme.Raised:Lerp(Color3.new(1, 1, 1), 0.06)
		})
	end)

	self:_on(button.MouseLeave, function()
		self:_tween(button, {BackgroundColor3 = self.Theme.Raised})
	end)

	drop.refresh()
	return drop
end

function Window:_openDropdown(drop)
	self:_closeDropdown(true)

	if not self.DropLayer then
		self.DropLayer = Lyra.Inst("Frame", {
			Name = "DropdownLayer",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 70,
			Visible = false
		}, self.Main)

		local catcher = Lyra.Inst("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false
		}, self.DropLayer)

		self:_on(catcher.Activated, function()
			self:_closeDropdown()
		end)
	end

	local scale = self.WindowScale.Scale > 0 and self.WindowScale.Scale or 1
	local at = (drop.Root.AbsolutePosition - self.Main.AbsolutePosition) / scale
	local buttonSize = drop.Root.AbsoluteSize / scale
	local area = self.Main.AbsoluteSize / scale

	local rowHeight = 38
	local width = math.max(180, buttonSize.X)
	local height = math.min(#drop.Options, 7) * rowHeight + 8
	local below = at.Y + buttonSize.Y + 6
	local up = below + height > area.Y - 8

	local x = math.clamp(at.X + buttonSize.X - width, 8, math.max(8, area.X - width - 8))
	local y = up and math.max(8, at.Y - height - 6) or below

	local panel = Lyra.Inst("CanvasGroup", {
		Position = UDim2.fromOffset(x, y + (up and 6 or -6)),
		Size = UDim2.fromOffset(width, height),
		BorderSizePixel = 0,
		GroupTransparency = 1
	}, self.DropLayer)
	self:_paint(panel, {BackgroundColor3 = "Card"})
	Lyra.Round(panel, 12)
	self:_stroke(panel, 0.45, "Accent")

	local scroll = Lyra.Inst("ScrollingFrame", {
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.new(1, -8, 1, -8),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		CanvasSize = UDim2.fromOffset(0, #drop.Options * rowHeight),
		ScrollingDirection = Enum.ScrollingDirection.Y
	}, panel)
	self:_paint(scroll, {ScrollBarImageColor3 = "AccentDark"})

	local current = drop.Get()
	for index, option in ipairs(drop.Options) do
		local selected = option.Value == current
		local row = Lyra.Inst("TextButton", {
			Position = UDim2.fromOffset(0, (index - 1) * rowHeight),
			Size = UDim2.new(1, 0, 0, rowHeight - 2),
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = selected and 0.4 or 1,
			BorderSizePixel = 0
		}, scroll)
		self:_paint(row, {BackgroundColor3 = "AccentDark"})
		Lyra.Round(row, 9)

		local text = self:_text(row, option.Label, 12, selected and "Text" or "Muted", selected)
		text.Position = UDim2.fromOffset(10, 0)
		text.Size = UDim2.new(1, -40, 1, 0)

		if selected then
			self:_icon(row, "check", UDim2.new(1, -30, 0.5, -12), "Accent")
		end

		self:_on(row.MouseEnter, function()
			if not selected then
				self:_tween(row, {BackgroundTransparency = 0.75})
			end
		end)

		self:_on(row.MouseLeave, function()
			if not selected then
				self:_tween(row, {BackgroundTransparency = 1})
			end
		end)

		self:_on(row.Activated, function()
			self:_closeDropdown()
			if option.Value ~= drop.Get() then
				drop.Set(option.Value)
				drop.refresh()
			end
		end)
	end

	if #drop.Options > 7 then
		for index, option in ipairs(drop.Options) do
			if option.Value == current then
				scroll.CanvasPosition = Vector2.new(0, math.max(0, (index - 4) * rowHeight))
			end
		end
	end

	self.OpenDrop, self.DropList = drop, panel
	self.DropLayer.Visible = true
	self:_tween(panel, {
		GroupTransparency = 0,
		Position = UDim2.fromOffset(x, y)
	}, 0.16)
	self:_tween(drop.Chevron, {Rotation = 180}, 0.16)
	self:_tint(drop.Stroke, {Color = "Accent"}, 0.16, {Transparency = 0.2})
end

function Window:_closeDropdown(instant)
	local drop, panel = self.OpenDrop, self.DropList
	if not drop then
		return
	end

	self.OpenDrop, self.DropList = nil, nil
	self:_tween(drop.Chevron, {Rotation = 0}, instant and 0 or 0.16)
	self:_tint(drop.Stroke, {Color = "Line"}, instant and 0 or 0.16, {Transparency = 0.6})

	if instant or self.Settings.ReducedMotion or self.Settings.LowEffects then
		panel:Destroy()
		self.DropLayer.Visible = false
		return
	end

	self:_tween(panel, {GroupTransparency = 1}, 0.1)
	task.delay(0.11, function()
		panel:Destroy()
		if not self.OpenDrop and self.DropLayer then
			self.DropLayer.Visible = false
		end
	end)
end

local function newContainer(window, frame, page)
	return setmetatable({
		Window = window,
		Frame = frame,
		Page = page,
		Order = 0
	}, Container)
end

function Window:Tab(spec, icon)
	if type(spec) ~= "table" then
		spec = {Title = spec, Icon = icon}
	end

	local title = tostring(spec.Title or spec.Name or ("Tab " .. tostring(#self.Tabs + 1)))

	local page = Lyra.Inst("ScrollingFrame", {
		Name = title,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		ClipsDescendants = true
	}, self.Content)
	self:_paint(page, {ScrollBarImageColor3 = "AccentDark"})
	Lyra.Padding(page, 2, 6, 10, 2)
	Lyra.ListLayout(page, spec.Gap or 8)

	self:_on(page:GetPropertyChangedSignal("CanvasPosition"), function()
		if self.OpenDrop then
			self:_closeDropdown()
		end
	end)

	local tab = newContainer(self, page, page)
	tab.Title, tab.Icon, tab.OnSelect = title, spec.Icon or "box", spec.OnSelect

	local index = #self.Tabs + 1
	local button = Lyra.Inst("TextButton", {
		Position = UDim2.fromOffset(6, 42 + (index - 1) * 54),
		Size = UDim2.new(1, -12, 0, 48),
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0
	}, self.Nav)
	self:_paint(button, {BackgroundColor3 = "Raised"})
	Lyra.Round(button, 12)

	local mini = self.LastMini == true
	local iconRoot = self:_icon(button, tab.Icon, UDim2.new(0, mini and 13 or 11, 0.5, -12), "Accent")

	local label = self:_text(button, title, 12, "Muted", true)
	label.Position = UDim2.fromOffset(44, 0)
	label.Size = UDim2.new(1, -48, 1, 0)
	label.Visible = self.NavShow ~= false

	local marker = Lyra.Inst("Frame", {
		Position = UDim2.new(0, 0, 0.5, -9),
		Size = UDim2.fromOffset(3, 18),
		BorderSizePixel = 0,
		Visible = false
	}, button)
	self:_paint(marker, {BackgroundColor3 = "Accent"})
	Lyra.Round(marker, 3)

	tab.RailButton = {
		Root = button,
		Label = label,
		Icon = iconRoot,
		Marker = marker
	}

	self:_on(button.Activated, function()
		self:SelectTab(tab)
	end)

	self:_on(button.MouseEnter, function()
		if self.CurrentTab ~= tab then
			self:_tween(button, {BackgroundTransparency = 0.55})
		end
	end)

	self:_on(button.MouseLeave, function()
		if self.CurrentTab ~= tab then
			self:_tween(button, {BackgroundTransparency = 1})
		end
	end)

	table.insert(self.Tabs, tab)
	if not self.CurrentTab then
		self:SelectTab(tab)
	end

	self:_layout(false)
	return tab
end

function Window:SelectTab(target)
	local tab = target
	if type(target) ~= "table" then
		for _, item in ipairs(self.Tabs) do
			if item.Title == target then
				tab = item
			end
		end
	end

	if type(tab) ~= "table" or not tab.Page then
		return
	end

	self.CurrentTab = tab
	self:_closeDropdown(true)

	if self.Drawer then
		self.Drawer = false
		self:_layout(false)
	end

	for _, item in ipairs(self.Tabs) do
		local on = item == tab
		item.Page.Visible = on
		self:_tween(item.RailButton.Root, {BackgroundTransparency = on and 0 or 1})
		self:_paint(item.RailButton.Label, {TextColor3 = on and "Text" or "Muted"})
		item.RailButton.Marker.Visible = on
	end

	self.Content.GroupTransparency = self.Settings.ReducedMotion and 0 or 0.25
	self:_tween(self.Content, {GroupTransparency = 0}, 0.22, nil, nil, "fade")
	self:_fire(tab.OnSelect, tab)
end

function Window:SetTitle(title, subtitle)
	if title then
		self.Title = tostring(title)
		self.HeaderTitle.Text = self.Title
	end
	if subtitle then
		self.Subtitle = tostring(subtitle)
		self.HeaderSubtitle.Text = self.Subtitle
	end
end

function Window:SetScale(percent)
	self.Settings.Scale = (tonumber(percent) or 0) <= 0 and 0 or math.clamp(tonumber(percent), 50, 150)
	self:_queueSave()
	self:_layout(false)
end

function Window:ResetSize()
	local s = self.Settings
	s.WindowW, s.WindowH, s.Scale = 0, 0, 0
	self.Maximized = false
	self:_syncSetting("Scale")
	self:_queueSave()
	self:_layout(true)
end

function Window:_syncSetting(key)
	local control = self.SettingControls[key]
	if control then
		control:Set(self.Settings[key], true)
	end
	self:_refreshReopen()
end

function Window:Destroy()
	if not self.Alive then
		return
	end
	if self.SavePending then
		pcall(self.Save, self)
	end
	self.Alive = false

	for _, connection in ipairs(self.Connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	for _, channels in pairs(self.Tweens) do
		for _, tween in pairs(channels) do
			pcall(function()
				tween:Cancel()
			end)
		end
	end

	for _, item in ipairs(self.ChatInstances) do
		pcall(function()
			item:Destroy()
		end)
	end

	pcall(function()
		self.Blur:Destroy()
	end)

	pcall(function()
		self.Gui:Destroy()
	end)

	self.Connections, self.Tweens, self.Painted, self.ThemeHooks, self.LayoutHooks = {}, {}, {}, {}, {}
	if Registry.Windows[self.Name] == self then
		Registry.Windows[self.Name] = nil
	end

	if type(self.Options.OnDestroy) == "function" then
		task.spawn(self.Options.OnDestroy)
	end
end

function Container:_add(item)
	self.Order = self.Order + 1
	item.LayoutOrder = self.Order
	return item
end

function Container:Select()
	if self.RailButton then
		self.Window:SelectTab(self)
	end
end

function Container:SetVisible(visible)
	visible = visible ~= false
	if self.RailButton then
		self.Hidden = not visible
		local window = self.Window
		window:_layout(false)
		if self.Hidden and window.CurrentTab == self then
			for _, tab in ipairs(window.Tabs) do
				if not tab.Hidden then
					window:SelectTab(tab)
					break
				end
			end
		end
		return
	end
	local root = self.Root or self.Frame
	root.Visible = visible
end

function Container:Destroy()
	if self.Root then
		self.Root:Destroy()
	end
end

function Container:Section(title, description)
	if type(title) == "table" then
		description = title.Description or title.Subtitle
		title = title.Title
	end

	local window = self.Window
	local frame = self:_add(Lyra.Inst("Frame", {
		Size = UDim2.new(1, 0, 0, description and 50 or 26),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1
	}, self.Frame))
	Lyra.Padding(frame, 2, 0, description and 4 or 0, 0)

	local label = window:_text(frame, title or "", 17, "Text", true)
	label.Size = UDim2.new(1, 0, 0, 24)

	local hint
	if description then
		hint = window:_text(frame, description, 12, "Muted")
		hint.Position = UDim2.fromOffset(0, 25)
		hint.Size = UDim2.new(1, 0, 0, 0)
		hint.AutomaticSize = Enum.AutomaticSize.Y
		hint.TextWrapped = true
		hint.TextTruncate = Enum.TextTruncate.None
		hint.TextYAlignment = Enum.TextYAlignment.Top
	end

	local object = element(frame, {
		TitleLabel = label,
		DescriptionLabel = hint
	})

	function object:Set(newTitle, newDescription)
		if newTitle then
			label.Text = tostring(newTitle)
		end
		if newDescription and hint then
			hint.Text = tostring(newDescription)
		end
	end

	return object
end

function Container:Paragraph(text, options)
