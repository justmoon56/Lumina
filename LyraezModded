function Container:Divider()
	local line = self:_add(Lyra.Inst("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0
	}, self.Frame))
	self.Window:_paint(line, {BackgroundColor3 = "Line"})
