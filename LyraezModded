function Container:Chips(spec)
	spec = spec or {}
	local window = self.Window
	local options = Lyra.NormalizeOptions(spec.Options)
	local default = spec.Default
	if default == nil and options[1] then
		default = options[1].Value
	end

	local value, restored = window:_initial(spec, default)
	local small = spec.Small == true
	local height = small and 30 or 34

	local scroll = self:_add(Lyra.Inst("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, height + 2),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ElasticBehavior = Enum.ElasticBehavior.Never
	}, self.Frame))
	Lyra.ListLayout(scroll, 6, Enum.FillDirection.Horizontal)

	local chips = {}
	local object = element(scroll, {Flag = spec.Flag})

	local function paint()
		for _, chip in ipairs(chips) do
			local selected = chip.Value == value
			window:_paint(chip.Root, {
				BackgroundColor3 = selected and "AccentDark" or "Raised",
				TextColor3 = selected and "Text" or "Muted"
			})
		end
	end

	local function build()
		for _, chip in ipairs(chips) do
			chip.Root:Destroy()
		end
		chips = {}

		for index, option in ipairs(options) do
			local chip = Lyra.Inst("TextButton", {
				LayoutOrder = index,
				Size = UDim2.fromOffset(0, height),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = option.Label,
				Font = Lyra.Font.Bold,
				TextSize = Lyra.TextSize(small and 11 or 12),
				AutoButtonColor = false,
				BorderSizePixel = 0
			}, scroll)
			Lyra.Round(chip, height / 2)
			Lyra.Padding(chip, 0, small and 12 or 14, 0, small and 12 or 14)

			table.insert(chips, {
				Root = chip,
				Value = option.Value
			})

			window:_on(chip.Activated, function()
				object:Set(option.Value)
			end)
		end
		paint()
	end

	function object:Set(newValue, silent)
		if newValue == value then
			return
		end
		value = newValue
		paint()
		window:_setFlag(spec.Flag, value)
		if not silent then
			window:_fire(spec.Callback, value)
		end
	end

	function object:Get()
		return value
	end

	function object:SetOptions(newOptions)
		options = Lyra.NormalizeOptions(newOptions)
		if Lyra.LabelFor(options, value) == nil then
			value = options[1] and options[1].Value or nil
		end
		build()
	end

	build()
	window:_registerFlag(spec.Flag, object)
	if restored then
		window:_fire(spec.Callback, value)
	end
	return object
end

