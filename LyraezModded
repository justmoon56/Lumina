	self:_add(root or frame)

	local object = element(root or frame, {
		Box = box,
		Flag = spec.Flag
	})

	local function submit(entered)
		value = box.Text
		window:_setFlag(spec.Flag, value)
		window:_fire(spec.Callback, value, entered == true)
	end

	if spec.Button then
		local go = window:_button(frame, "", false, function()
			submit(true)
		end, spec.ButtonIcon or "arrow")
		go.Root.Size = UDim2.fromOffset(38, 34)
		go.Root.Position = UDim2.new(1, -42, 0.5, -17)
		object.Button = go
	end

	window:_on(box.Focused, function()
		window:_tint(border, {Color = "Accent"}, nil, {Transparency = 0.15})
	end)

	window:_on(box.FocusLost, function(enter)
		window:_tint(border, {Color = "Line"}, nil, {Transparency = 0.55})
		submit(enter)
	end)

	local token = 0
	window:_on(box:GetPropertyChangedSignal("Text"), function()
		local text = box.Text
		if spec.Numeric then
			text = text:gsub("[^%d%.%-]", "")
		end
		if spec.MaxLength and #text > spec.MaxLength then
			text = text:sub(1, spec.MaxLength)
		end
		if text ~= box.Text then
			box.Text = text
			return
		end
		if spec.Changed then
			token = token + 1
			local mine = token
			task.delay(spec.Debounce or 0.25, function()
				if window.Alive and mine == token then
					window:_fire(spec.Changed, box.Text)
				end
			end)
		end
	end)

	function object:Set(text, silent)
		box.Text = tostring(text or "")
		value = box.Text
		window:_setFlag(spec.Flag, value)
		if not silent then
			window:_fire(spec.Callback, value, false)
		end
	end

	function object:Get()
		return box.Text
	end

	function object:Focus()
		box:CaptureFocus()
	end

	window:_registerFlag(spec.Flag, object)
	if restored then
		window:_fire(spec.Callback, value, false)
	end
	return object
end

