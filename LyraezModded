		line(5, 9, 8, 5)
		line(8, 5, 17, 5)
		line(17, 5, 21, 12)
		line(21, 12, 17, 19)
		line(17, 19, 8, 19)
		line(8, 19, 4, 15)
		line(3, 4, 3, 10)
