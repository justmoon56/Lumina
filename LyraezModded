		line(21, 2, 21, 16)
		line(7, 10, 13, 10)
		line(7, 14, 12, 14)
	elseif name == "settings" then
		for _, row in ipairs({{5, 8}, {12, 16}, {19, 10}}) do
			line(3, row[1], 21, row[1])
			box(row[2] - 2, row[1] - 2, 4, 4, 4, true)
		end
	elseif name == "creator" or name == "code" then
		line(8, 6, 2, 12)
		line(2, 12, 8, 18)
		line(16, 6, 22, 12)
		line(22, 12, 16, 18)
		line(14, 3, 10, 21)
	elseif name == "search" then
		box(3, 3, 12, 12, 12)
		line(14, 14, 21, 21)
	elseif name == "close" then
		line(6, 6, 18, 18)
		line(18, 6, 6, 18)
	elseif name == "menu" then
		line(4, 6, 20, 6)
		line(4, 12, 20, 12)
		line(4, 18, 20, 18)
	elseif name == "expand" then
		line(4, 9, 4, 4)
