	if spec.Icon ~= false then
		window:_icon(frame, spec.Icon or "search", UDim2.new(0, 11, 0.5, -12), "Muted")
		left = 42
	end

	local box = Lyra.Inst("TextBox", {
		Position = UDim2.fromOffset(left, 0),
		Size = UDim2.new(1, -(left + 12 + (spec.Button and 46 or 0)), 1, 0),
		BackgroundTransparency = 1,
