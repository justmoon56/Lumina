-- BUILT-IN SETTINGS TAB
-- =============================================================================
-- Interface size, window size, theme, notifications, start hidden, the ways to reopen the window and
-- the effects. Returns the tab, so a script can add its own options under them.
function Window:_reopenCard(container)
	local card = container:_add(self:_autoCard(container.Frame, 6, 14))
	self.ReopenRows = {}
	for index = 1, 4 do
		local row = Lyra.Inst("Frame", {
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, 22),
			BackgroundTransparency = 1
		}, card)

		local name = self:_text(row, "", 12, "Text", true)
		name.Size = UDim2.new(0.58, 0, 1, 0)

		local state = self:_text(row, "", 12, "Muted", true)
		state.Position = UDim2.new(0.58, 0, 0, 0)
		state.Size = UDim2.new(0.42, 0, 1, 0)
		state.TextXAlignment = Enum.TextXAlignment.Right

		self.ReopenRows[index] = {Root = row, Name = name, State = state}
	end

	self.ReopenWarning = self:_paragraph(card, "", 11, "Gold", true)
	self.ReopenWarning.LayoutOrder = 10
	return card
end

-- Live status of every way to bring the hidden window back, so a player can see what works on this device.
function Window:_refreshReopen()
	local rows = self.ReopenRows
	if not rows then
		return
	end
	local s = self.Settings
	local keyboard = UserInputService.KeyboardEnabled
	local data = {
		{"Floating button", s.FloatingButton and "On" or "Off", s.FloatingButton and "Green" or "Muted"},
		{"Roblox menu shortcut", s.MenuReopen and "On" or "Off", s.MenuReopen and "Green" or "Muted"},
		{"Shortcut key (" .. s.Keybind .. ")", keyboard and "Ready" or "No keyboard", keyboard and "Green" or "Gold"},
	}
	if self.ChatAlias then
		local chat = (self.ChatOK == false and {"Blocked on this account", "Gold"}) or (self.ChatOK == true and {"Ready", "Green"})
			or (self.ChatChecked and {"Not detected", "Muted"}) or {"Checking…", "Muted"}
		table.insert(data, {"Chat  " .. self.ChatAlias, chat[1], chat[2]})
	end
	for index, row in ipairs(rows) do
		local entry = data[index]
		row.Root.Visible = entry ~= nil
		if entry then
			row.Name.Text, row.State.Text = entry[1], entry[2]
			self:_paint(row.State, {TextColor3 = entry[3]})
		end
	end
	local can = self:_canReopen()
	self.ReopenWarning.Text = can and "" or "Nothing can reopen the window right now. Turn on the floating button or the Roblox menu shortcut."
	self.ReopenWarning.Visible = not can
end

function Window:SettingsTab(spec)
	spec = spec or {}
	local s, controls = self.Settings, self.SettingControls
	local tab = self:Tab({
		Title = spec.Title or "Settings",
		Icon = spec.Icon or "sliders-horizontal"
	})
	tab:Section(spec.Title or "Settings", spec.Description or "The defaults work for most people. Change only what you need.")

	local function setting(key, after)
		return function(value)
			s[key] = value
			self:_queueSave()
			if after then
				after(value)
			end
		end
	end

	controls.Scale = tab:Stepper({
		Title = "Interface size",
		Description = "Makes the window and its text smaller or larger. Auto fits your screen.",
		Values = {0, 70, 75, 80, 85, 90, 95, 100, 105, 110, 115, 120, 130},
		Default = s.Scale,
		Format = function(value)
			return value == 0 and "Auto" or (tostring(value) .. "%")
		end,
		Callback = setting("Scale", function()
			self:_layout(false)
		end)
	})

	tab:Action({
		Title = "Window size",
		Description = "Drag the corner at the bottom right of the window to resize it. Reset restores the default size.",
		Button = "Reset",
		Icon = "reset",
		Callback = function()
			self:ResetSize()
			self:Status("Window size and interface size reset.", "info")
		end
	})

	if spec.Themes ~= false then
		controls.Theme = tab:Dropdown({
			Title = "Theme",
			Description = "The colours of the whole window.",
			Options = Lyra.ThemeNames,
			Default = self.ThemeName,
			Placeholder = "Custom",
			Callback = function(name)
				self:SetTheme(name)
			end
		})
	end

	tab:Section("Notifications")
	controls.Notifications = tab:Toggle({
		Title = "Show notifications",
		Description = "Small pop-ups in the bottom-right corner. Turn off to hide them all.",
		Default = s.Notifications,
		Callback = setting("Notifications", function(on)
			if not on then
				self.Toasts:Clear()
			end
		end)
	})

	tab:Section("Open & close")
	controls.StartHidden = tab:Toggle({
		Title = "Start hidden",
		Description = "The window stays closed when the script runs. It is skipped if nothing could reopen the window.",
		Default = s.StartHidden,
		Callback = setting("StartHidden")
	})

	tab:Section("How to reopen the window", "Keep at least one on, so the window can always come back.")
	self:_reopenCard(tab)

	controls.FloatingButton = tab:Toggle({
		Title = "Floating button",
		Description = "Shows a draggable button while the window is closed.",
		Default = s.FloatingButton,
		Callback = setting("FloatingButton", function()
			self:_effects()
			self:_refreshReopen()
		end)
	})

	controls.MenuReopen = tab:Toggle({
		Title = "Reopen with the Roblox menu",
		Description = "While the window is hidden, open and close the Roblox menu 3 times in a row (Esc on PC, the Roblox logo on phones). Works without chat.",
		Default = s.MenuReopen,
		Callback = setting("MenuReopen", function()
			self:_refreshReopen()
		end)
	})

	controls.Keybind = tab:Keybind({
		Title = "Window shortcut",
		Description = "Tap, then press a key to change it. Esc cancels.",
		Default = s.Keybind,
		Blocked = {"W", "A", "S", "D", "Space", "Return", "Tab", "Backspace", "Slash"},
		Changed = setting("Keybind", function()
			self:_refreshReopen()
		end)
	})

	local advanced = tab:Collapsible({
		Title = "Show advanced options",
		OpenTitle = "Hide advanced options"
	})
	advanced:Section("Effects")

	controls.Blur = advanced:Toggle({
		Title = "Background blur",
		Description = "Blurs the game behind the window.",
		Default = s.Blur,
		Callback = setting("Blur", function()
			self:_effects()
		end)
	})

	controls.ReducedMotion = advanced:Toggle({
		Title = "Reduced motion",
		Description = "Turns off window animations.",
		Default = s.ReducedMotion,
		Callback = setting("ReducedMotion", function()
			self:_effects()
		end)
	})

	controls.LowEffects = advanced:Toggle({
		Title = "Performance mode",
		Description = "Turns off extra visual effects. Helps on slower devices.",
		Default = s.LowEffects,
		Callback = setting("LowEffects", function()
			self:_effects()
		end)
	})

	tab.Advanced = advanced
	self:_refreshReopen()
	return tab
end

-- [[ Familiar names for people coming from other libraries: Tab:AddToggle, Window:AddTab… ]]
for _, name in ipairs({
	"Section", "Paragraph", "Label", "Divider", "Button", "ButtonRow", "Action", "Toggle", "Stepper", "Slider", "Dropdown", "Input",
	"TextArea", "Keybind", "Chips", "Segmented", "Group", "Columns", "Collapsible", "Guide", "Row", "Empty", "List", "Grid", "Preview", "Strip",
	"Link", "Profile", "Image"
}) do
	Container["Add" .. name] = Container[name]
end
Window.AddTab = Window.Tab
Window.Dialog = Window.Confirm
-- [[ Window:Connect(signal, fn): a connection that is disconnected when the window is destroyed. ]]
Window.Connect = Window._connect

function Lyra.GetWindow(...)
	local name = args(...)
	return Registry.Windows[tostring(name)]
end

function Lyra.DestroyAll()
	for _, window in pairs(Registry.Windows) do
		if type(window) == "table" and type(window.Destroy) == "function" then
			pcall(window.Destroy, window)
		end
	end
end

return Lyra
