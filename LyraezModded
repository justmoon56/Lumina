local function drawIcon(parent, name, position, color)
	local root = Lyra.Inst("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(24, 24),
		Position = position or UDim2.new()
	}, parent)

	local parts = {}

	if type(name) == "number" then
		name = "rbxassetid://" .. tostring(name)
	end
	name = tostring(name or "box")

	if name:find("^rbxasset") or name:find("^rbxthumb") then
		local image = Lyra.Inst("ImageLabel", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Image = name,
			ImageColor3 = color,
			ScaleType = Enum.ScaleType.Fit
		}, root)
		table.insert(parts, {image, "ImageColor3"})
		return root, parts
	end

	local spriteName = Lyra.IconAlias[name] or name
	local index = Lyra.IconIndex[spriteName]

	if Lyra.IconSheet and index then
		local image = Lyra.Inst("ImageLabel", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Image = Lyra.IconSheet,
			ImageRectOffset = Vector2.new(((index - 1) % 8) * 64, math.floor((index - 1) / 8) * 64),
			ImageRectSize = Vector2.new(64, 64),
			ImageColor3 = color,
			ScaleType = Enum.ScaleType.Fit
		}, root)
		table.insert(parts, {image, "ImageColor3"})
		return root, parts
	end

	name = VectorAlias[name] or VectorAlias[spriteName] or name

	local function line(x1, y1, x2, y2)
		local dx, dy = x2 - x1, y2 - y1
		local item = Lyra.Inst("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
			Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), 1.8),
			Rotation = math.deg(math.atan2(dy, dx)),
			BackgroundColor3 = color,
			BorderSizePixel = 0
		}, root)
		Lyra.Round(item, 2)
		table.insert(parts, {item, "BackgroundColor3"})
	end

	local function box(x, y, w, h, radius, filled)
		local item = Lyra.Inst("Frame", {
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(w, h),
			BackgroundColor3 = color,
			BackgroundTransparency = filled and 0 or 1,
			BorderSizePixel = 0
		}, root)
		Lyra.Round(item, radius or 3)
		if filled then
			table.insert(parts, {item, "BackgroundColor3"})
		else
			table.insert(parts, {
				Lyra.Inst("UIStroke", {
					Color = color,
					Thickness = 1
				}, item),
				"Color"
			})
		end
	end

	if name == "avatar" then
		box(8, 3, 8, 8, 8)
		line(5, 21, 5, 18)
		line(5, 18, 8, 15)
		line(8, 15, 16, 15)
