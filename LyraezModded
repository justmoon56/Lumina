end

function Window:_button(parent, text, primary, callback, icon)
	local window = self
	local root = Lyra.Inst("TextButton", {
		Size = UDim2.new(1, 0, 0, 44),
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0
	}, parent)
	Lyra.Round(root, 12)

	local object = element(root, {
		Key = primary and "Accent" or "Raised",
		Primary = primary == true,
		Enabled = true,
		Callback = callback
	})

	self:_paint(root, {BackgroundColor3 = object.Key})

	local label = self:_text(root, text or "", 13, primary and "Base" or "Text", true)
	object.Label = label

	if icon then
		object.Icon, object.IconParts = self:_icon(
			root,
			icon,
			UDim2.new(0, 10, 0.5, -12),
			primary and "Base" or "Accent"
		)
	end

	function object:Place()
		local showIcon = object.Icon ~= nil and object.Icon.Visible
		local hasText = label.Text ~= ""
		if object.Icon then
			object.Icon.Position = (hasText or not showIcon)
				and UDim2.new(0, 10, 0.5, -12)
				or UDim2.new(0.5, -12, 0.5, -12)
		end
		label.Position = UDim2.fromOffset(showIcon and 40 or 8, 0)
		label.Size = UDim2.new(1, showIcon and -48 or -16, 1, 0)
		label.TextXAlignment = showIcon and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
	end

	function object:SetText(value)
		label.Text = tostring(value or "")
		object:Place()
	end

	function object:GetText()
		return label.Text
	end

	function object:SetIconVisible(visible)
		if object.Icon then
			object.Icon.Visible = visible ~= false
			object:Place()
		end
	end

	function object:SetKey(key)
		object.Key = key
		window:_tint(root, {BackgroundColor3 = key})
	end

	function object:SetPrimary(on)
		object.Primary = on == true
		object:SetKey(on and "Accent" or "Raised")
		window:_paint(label, {TextColor3 = on and "Base" or "Text"})
		window:_recolor(object.IconParts, on and "Base" or "Accent")
	end

	function object:SetEnabled(on)
		on = on ~= false
		object.Enabled = on
		root.Active = on
		root.Selectable = on
		label.TextTransparency = on and 0 or 0.55
		root.BackgroundTransparency = on and 0 or 0.55
	end

	function object:Fire()
		if object.Enabled then
			window:_fire(object.Callback)
		end
	end

	self:_on(root.MouseEnter, function()
		if object.Enabled then
			self:_tween(root, {
				BackgroundColor3 = self.Theme[object.Key]:Lerp(Color3.new(1, 1, 1), 0.08)
			})
		end
	end)

	self:_on(root.MouseLeave, function()
		self:_tween(root, {BackgroundColor3 = self.Theme[object.Key]})
	end)

	self:_on(root.InputBegan, function(input)
		if object.Enabled and Lyra.IsPointer(input) then
			self:_tween(root, {
				BackgroundColor3 = self.Theme[object.Key]:Lerp(self.Theme.Base, 0.18)
			}, 0.08)
		end
	end)

	self:_on(root.InputEnded, function(input)
		if Lyra.IsPointer(input) then
			self:_tween(root, {BackgroundColor3 = self.Theme[object.Key]})
		end
	end)

	self:_on(root.Activated, function()
		object:Fire()
	end)

	object:Place()
	return object
end

