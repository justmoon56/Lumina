local Window = {}
Window.__index = Window

local Container = {}
Container.__index = Container

local Element = {}
Element.__index = Element

function Element:SetVisible(visible)
	self.Root.Visible = visible ~= false
end

function Element:Destroy()
	if self.Root then
		self.Root:Destroy()
	end
end

local function element(root, fields)
	local object = setmetatable(fields or {}, Element)
	object.Root = root
	return object
end

Lyra.Element, Lyra.Container, Lyra.WindowClass = Element, Container, Window

local HEADER = 52
local STATUS_KEYS = {
	error = "Red",
	warning = "Gold",
	success = "Green",
	loading = "Accent",
	info = "Muted"
}

local DEFAULT_SETTINGS = {
	Scale = 0,
	WindowW = 0,
	WindowH = 0,
	Blur = true,
	ReducedMotion = false,
	LowEffects = false,
	FloatingButton = true,
	MenuReopen = true,
	StartHidden = false,
	Keybind = "RightControl",
	Notifications = true,
	HideTipSeen = false,
	Theme = ""
}

function Lyra.CreateWindow(...)
	local options = Lyra.Args(...)
	options = type(options) == "table" and options or {}

	local self = setmetatable({}, Window)
	self.Options = options
	self.Title = tostring(options.Title or "Lyra UI")
	self.Subtitle = tostring(options.Subtitle or ("Lyra UI · v" .. Lyra.Version))
	self.Name = tostring(options.Name or self.Title)
	self.Alive = true

	self.Connections = {}
	self.Tweens = {}
	self.Painted = {}
	self.PaintCount = 0
	self.PruneAt = 600
	self.ThemeHooks = {}
	self.LayoutHooks = {}
	self.Tabs = {}
	self.Flags = {}
	self.FlagObjects = {}
	self.Keybinds = {}
	self.Commands = {}
	self.ChatInstances = {}
	self.SettingControls = {}

	self.Visible = true
	self.Minimized = false
	self.Maximized = false
	self.Drawer = false

	local size = options.Size
	if typeof(size) == "Vector2" then
		self.DefaultW, self.DefaultH = size.X, size.Y
	elseif typeof(size) == "UDim2" then
		self.DefaultW, self.DefaultH = size.X.Offset, size.Y.Offset
	elseif type(size) == "table" then
		self.DefaultW = size.Width or size.W or size[1]
		self.DefaultH = size.Height or size.H or size[2]
	end

	self.DefaultW = math.clamp(tonumber(self.DefaultW) or 820, 300, 4000)
	self.DefaultH = math.clamp(tonumber(self.DefaultH) or 600, 240, 4000)

	local previous = Registry.Windows[self.Name]
	if type(previous) == "table" and previous ~= self and type(previous.Destroy) == "function" then
		pcall(previous.Destroy, previous)
	end
	Registry.Windows[self.Name] = self

	self:_loadConfig()
	local saved = self.Settings.Theme
	self.Theme, self.ThemeName = Lyra.ResolveTheme(saved ~= "" and Lyra.Themes[saved] and saved or options.Theme)
	self:_build()

	return self
end

Lyra.new = Lyra.CreateWindow

function Window:_loadConfig()
	local o, s = self.Options, {}
	for key, value in pairs(DEFAULT_SETTINGS) do
		s[key] = value
	end

	if o.Keybind ~= nil then
		s.Keybind = typeof(o.Keybind) == "EnumItem" and o.Keybind.Name or tostring(o.Keybind)
	end

	for _, key in ipairs({"FloatingButton", "Blur", "MenuReopen", "StartHidden", "Notifications", "ReducedMotion", "LowEffects"}) do
		if type(o[key]) == "boolean" then
			s[key] = o[key]
		end
	end

	if type(o.Scale) == "number" then
		s.Scale = o.Scale
	end

	self.Settings, self.Saved = s, {}
	local file = o.ConfigFile

	if file ~= false then
		if type(file) ~= "string" or file == "" then
			local clean = self.Name:gsub("[^%w%-_ ]", ""):gsub("%s+", "_")
			file = "LyraUI/" .. (clean ~= "" and clean or "Window")
		end
		if not file:find("%.json$") then
			file = file .. ".json"
		end
		self.ConfigPath = file

		local raw = Files.read(file)
		if raw then
			local ok, data = pcall(function()
				return HttpService:JSONDecode(raw)
			end)
			if ok and type(data) == "table" then
				if type(data.Settings) == "table" then
					for key, value in pairs(data.Settings) do
						if DEFAULT_SETTINGS[key] ~= nil and type(value) == type(DEFAULT_SETTINGS[key]) then
							s[key] = value
						end
					end
				end
				if type(data.Flags) == "table" then
					self.Saved = data.Flags
				end
			end
		end
	end

	s.Scale = s.Scale == 0 and 0 or math.clamp(s.Scale, 50, 150)
	s.WindowW = s.WindowW == 0 and 0 or math.clamp(s.WindowW, 300, 4000)
	s.WindowH = s.WindowH == 0 and 0 or math.clamp(s.WindowH, 240, 4000)
end

function Window:Save()
	self.SavePending = false
	if not self.ConfigPath then
		return false
	end

	local flags = {}
	for key, value in pairs(self.Saved) do
		flags[key] = value
	end
	for key, value in pairs(self.Flags) do
		local kind = type(value)
		if kind == "boolean" or kind == "number" or kind == "string" then
			flags[key] = value
		end
	end

	local ok, json = pcall(function()
		return HttpService:JSONEncode({
			Version = 1,
			Settings = self.Settings,
			Flags = flags
		})
	end)

	return ok and Files.write(self.ConfigPath, json) or false
end

function Window:_queueSave()
	if not self.ConfigPath then
		return
	end
	self.SavePending = true
	self.SaveToken = (self.SaveToken or 0) + 1
	local token = self.SaveToken

	task.delay(0.4, function()
		if self.Alive and token == self.SaveToken then
			self:Save()
		end
	end)
end

function Window:_initial(spec, default)
	local flag = spec.Flag
	if flag ~= nil then
		local saved = self.Saved[flag]
		if saved ~= nil and (default == nil or type(saved) == type(default)) then
			return saved, saved ~= default
		end
	end
	return default, false
end

function Window:_setFlag(flag, value)
	if flag == nil then
		return
	end
	self.Flags[flag] = value
	self:_queueSave()
end

function Window:_registerFlag(flag, object)
	if flag == nil then
		return
	end
	self.FlagObjects[flag] = object
	self.Flags[flag] = object:Get()
end

function Window:GetFlag(flag)
	return self.Flags[flag]
end

function Window:SetFlag(flag, value)
	local object = self.FlagObjects[flag]
	if object then
		object:Set(value)
	else
		self.Flags[flag] = value
		self:_queueSave()
	end
end

function Window:_connect(signal, fn)
	local connection = signal:Connect(function(...)
		if self.Alive then
			fn(...)
		end
	end)
	table.insert(self.Connections, connection)
	return connection
end

function Window:_on(signal, fn)
	return signal:Connect(function(...)
		if self.Alive then
			fn(...)
		end
	end)
end

function Window:_fire(callback, ...)
	if type(callback) ~= "function" then
		return
	end
	task.spawn(function(...)
		local ok, problem = pcall(callback, ...)
		if not ok then
			warn("[Lyra UI] " .. tostring(problem))
			if self.Alive and self.StatusText then
				self:Status("A callback failed: " .. tostring(problem), "error")
			end
		end
	end, ...)
end

function Window:_tween(item, goal, duration, style, direction, channel)
	if not item or not self.Alive then
		return
	end
	channel = channel or "main"

	local running = self.Tweens[item]
	if running and running[channel] then
		running[channel]:Cancel()
		running[channel] = nil
	end

	local s = self.Settings
	if s.ReducedMotion or s.LowEffects or (duration or 0.18) <= 0 then
		for key, value in pairs(goal) do
			item[key] = value
		end
		return
	end

	local tween = TweenService:Create(
		item,
		TweenInfo.new(duration or 0.18, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
		goal
	)

	running = self.Tweens[item] or {}
	self.Tweens[item] = running
	running[channel] = tween

	local connection
	connection = tween.Completed:Connect(function()
		connection:Disconnect()
		local current = self.Tweens[item]
		if current and current[channel] == tween then
			current[channel] = nil
			if next(current) == nil then
				self.Tweens[item] = nil
			end
		end
	end)

	tween:Play()
end

function Window:_stopTween(item, channel)
	local running = self.Tweens[item]
	channel = channel or "main"
	if running and running[channel] then
		running[channel]:Cancel()
		running[channel] = nil
	end
end

function Window:_paint(item, map)
	local entry = self.Painted[item]
	if not entry then
		entry = {}
		self.Painted[item] = entry
		self.PaintCount = self.PaintCount + 1
		if self.PaintCount > self.PruneAt then
			self:_prune()
		end
	end

	for property, value in pairs(map) do
		if type(value) == "string" then
			entry[property] = value
			local color = self.Theme[value]
			if color then
				item[property] = color
			end
		else
			entry[property] = nil
			item[property] = value
		end
	end
	return item
end

function Window:_tint(item, map, duration, extra)
	local goal = {}
	for key, value in pairs(extra or {}) do
		goal[key] = value
	end

	local entry = self.Painted[item] or {}
	if not self.Painted[item] then
		self.Painted[item] = entry
		self.PaintCount = self.PaintCount + 1
	end

	for property, value in pairs(map) do
		if type(value) == "string" then
			entry[property] = value
			goal[property] = self.Theme[value]
		else
			entry[property] = nil
			goal[property] = value
		end
	end

	self:_tween(item, goal, duration)
end

function Window:_prune()
	local count = 0
	for item in pairs(self.Painted) do
		if item.Parent == nil then
			self.Painted[item] = nil
		else
			count = count + 1
		end
	end
	self.PaintCount = count
	self.PruneAt = math.max(600, count * 2)
end

function Window:_color(value)
	return type(value) == "string" and self.Theme[value] or value
end

function Window:_onTheme(root, fn)
	table.insert(self.ThemeHooks, {Root = root, Fn = fn})
	fn()
end

function Window:_onLayout(root, fn)
	table.insert(self.LayoutHooks, {Root = root, Fn = fn})
	if self.LayoutState then
		fn(self.LayoutState)
	end
end

function Window:SetTheme(value)
	local theme, name = Lyra.ResolveTheme(value)
	self.Theme, self.ThemeName = theme, name

	if name and self.Settings.Theme ~= name then
		self.Settings.Theme = name
		self:_queueSave()
	end

	self:_prune()
	for item, map in pairs(self.Painted) do
		for property, key in pairs(map) do
			local color = theme[key]
			if color then
				pcall(function()
					item[property] = color
				end)
			end
		end
	end

	Lyra.RunHooks(self.ThemeHooks)
	Animation.Apply(self.Theme, self.Main)

	local drop = self.SettingControls.Theme
	if drop and name then
		drop:Set(name, true)
	end
end

function Window:GetTheme()
	return self.Theme, self.ThemeName
end

function Window:_text(parent, value, size, color, bold)
	local label = Lyra.Inst("TextLabel", {
		BackgroundTransparency = 1,
		Text = tostring(value or ""),
		TextSize = Lyra.TextSize(size),
		Font = bold and Lyra.Font.Bold or Lyra.Font.Regular,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BorderSizePixel = 0
	}, parent)

	self:_paint(label, {TextColor3 = color or "Text"})
	return label
end

function Window:_paragraph(parent, value, size, color, bold)
	local label = self:_text(parent, value, size, color, bold)
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.TextWrapped = true
	label.TextTruncate = Enum.TextTruncate.None
	label.TextYAlignment = Enum.TextYAlignment.Top
	return label
end

function Window:_stroke(item, transparency, color)
	local stroke = Lyra.Inst("UIStroke", {
		Transparency = transparency or 0.3,
		Thickness = 1
	}, item)
	self:_paint(stroke, {Color = color or "Line"})
	return stroke
end

function Window:_card(parent, height)
	local card = Lyra.Inst("Frame", {
		Size = UDim2.new(1, 0, 0, height or 58),
		BackgroundTransparency = 0.22,
		BorderSizePixel = 0
	}, parent)

	self:_paint(card, {BackgroundColor3 = "Card"})
	Lyra.Round(card, 16)
	self:_stroke(card, 0.55)
	return card
end

function Window:_autoCard(parent, gap, pad)
	local card = self:_card(parent, 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	Lyra.ListLayout(card, gap or 10)
	Lyra.Padding(card, pad or 16, pad or 16, pad or 16, pad or 16)
	return card
end

function Window:_icon(parent, name, position, color)
	color = color or "Muted"
	local root, parts = drawIcon(parent, name, position, self:_color(color))
	if type(color) == "string" then
		for _, part in ipairs(parts) do
			self:_paint(part[1], {[part[2]] = color})
		end
	end
	return root, parts
end

function Window:_recolor(parts, color)
	for _, part in ipairs(parts or {}) do
		self:_paint(part[1], {[part[2]] = color})
	end
end

function Window:_gradient(parent, keyA, keyB, rotation)
	local gradient = Lyra.Inst("UIGradient", {
		Rotation = rotation or 0
	}, parent)

	self:_onTheme(gradient, function()
		gradient.Color = ColorSequence.new(self.Theme[keyA], self.Theme[keyB])
	end)
	return gradient
end

function Window:_brandMark(parent, radius, size)
	local logo = self.Options.Logo
	if logo ~= nil and logo ~= "" then
		if type(logo) == "number" then
			logo = "rbxassetid://" .. tostring(logo)
		end
		local image = Lyra.Inst("ImageLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = tostring(logo),
			ScaleType = Enum.ScaleType.Crop
		}, parent)
		Lyra.Round(image, radius)
		return image
	end

	local letters = self:_text(parent, self.Options.LogoText or Lyra.Initials(self.Title), size or 15, "Text", true)
