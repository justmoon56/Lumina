	elseif name == "undo" then
		line(8, 5, 3, 10)
		line(3, 10, 8, 15)
		line(3, 10, 15, 10)
		line(15, 10, 19, 14)
		line(19, 14, 19, 18)
	elseif name == "copy" then
		box(3, 7, 13, 14, 3)
		line(8, 3, 21, 3)
