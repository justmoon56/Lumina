function Toast.new(options)
	assert(type(options) == "table" and options.Parent, "Toast.new needs {Parent = Instance}")
	local self = setmetatable({}, Toast)
	self.Options = options
	self:SetTheme(options.Theme)
	self.Font = options.Font or {
		Regular = Enum.Font.Gotham,
		Bold = Enum.Font.GothamBold
	}
	self.Width = options.Width or 264
	self.Max = options.Max or 4
	self.Margin = options.Margin or 12
	self.Lift = options.Lift or 0
	self.Active = {}

	self.Container = Lyra.Inst("Frame", {
		Name = "LyraToasts",
		BackgroundTransparency = 1,
		ZIndex = 200,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -self.Margin, 1, -(self.Margin + self.Lift)),
		Size = UDim2.new(0, self.Width, 1, -(self.Margin * 2 + self.Lift))
	})

	Lyra.Inst("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Bottom
	}, self.Container)

	self.Container.Parent = options.Parent
	self.Order = 0
	return self
end

function Toast:SetTheme(theme)
	local merged, kinds = {}, {}
	for key, value in pairs(Toast.DefaultTheme) do
		merged[key] = value
	end
	for key, value in pairs(type(theme) == "table" and theme or {}) do
		merged[key] = value
	end
	for key, value in pairs(Toast.DefaultTheme.Kinds) do
		kinds[key] = value
	end
	for key, value in pairs(type(theme) == "table" and type(theme.Kinds) == "table" and theme.Kinds or {}) do
		kinds[key] = value
	end
	self.Theme, self.Kinds = merged, kinds
end

function Toast:_reduced()
	local check = self.Options.ReducedMotion
	return type(check) == "function" and check() == true
end

function Toast:_tween(item, goal, duration)
	if self:_reduced() then
		for key, value in pairs(goal) do
			item[key] = value
		end
		return nil
	end
	local tween = TweenService:Create(item, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), goal)
	tween:Play()
	return tween
end

function Toast.glyph(parent, name, color)
	local function stroke(x1, y1, x2, y2)
		local dx, dy = x2 - x1, y2 - y1
		local item = Lyra.Inst("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
			Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + 2, 2),
			Rotation = math.deg(math.atan2(dy, dx)),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = 203
		}, parent)
		Lyra.Round(item, 99)
	end

	local function dot(x, y)
		local item = Lyra.Inst("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(2.6, 2.6),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = 203
		}, parent)
		Lyra.Round(item, 99)
	end

	if name == "check" then
		stroke(7.5, 12.5, 10.5, 15.5)
		stroke(10.5, 15.5, 16.5, 9)
	elseif name == "cross" then
		stroke(8.5, 8.5, 15.5, 15.5)
		stroke(15.5, 8.5, 8.5, 15.5)
	elseif name == "alert" then
		stroke(12, 7.5, 12, 12.5)
		dot(12, 16.2)
	else
		dot(12, 7.8)
		stroke(12, 11, 12, 16.5)
	end
