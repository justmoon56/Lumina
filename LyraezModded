function Container:ButtonRow(buttons, options)
	options = options or {}
	local window = self.Window
	local frame = self:_add(Lyra.Inst("Frame", {
		Size = UDim2.new(1, 0, 0, options.Height or 40),
		BackgroundTransparency = 1
	}, self.Frame))

	local items, roots = {}, {}
	for _, spec in ipairs(buttons or {}) do
		local button = window:_button(frame, spec.Title or "", spec.Primary, spec.Callback, spec.Icon)
		if spec.Enabled == false then
			button:SetEnabled(false)
		end
		table.insert(items, button)
		table.insert(roots, button.Root)
	end

	Lyra.Spread(roots, options.Gap or 8)

	window:_onLayout(frame, function(state)
		for _, button in ipairs(items) do
			if button.Label.Text ~= "" then
				button:SetIconVisible(not state.Compact)
			end
		end
	end)

	return element(frame, {Buttons = items})
end

function Container:Action(spec)
	spec = spec or {}
	local window = self.Window
	local text = tostring(spec.Button or "Run")
	local width = spec.Width or math.max(96, math.ceil(Lyra.Measure(text, Lyra.TextSize(13), Lyra.Font.Bold).X) + (spec.Icon and 56 or 30))

	local card = self:_add((window:_controlCard(self.Frame, spec.Title or "Action", spec.Description, width)))
	local button = window:_button(card, text, spec.Primary, spec.Callback, spec.Icon)
	button.Root.Size = UDim2.fromOffset(width, 38)
	button.Root.Position = UDim2.new(1, -(width + 12), 0.5, -19)

	return element(card, {Button = button})
end

function Container:Toggle(spec)
	spec = spec or {}
	local window = self.Window
	local value, restored = window:_initial(spec, spec.Default == true)
	value = value == true

	local card = self:_add((window:_controlCard(self.Frame, spec.Title or "Toggle", spec.Description, 58)))
	local switch = Lyra.Inst("TextButton", {
		Position = UDim2.new(1, -62, 0.5, -15),
		Size = UDim2.fromOffset(50, 30),
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0
	}, card)
	Lyra.Round(switch, 30)

	local knob = Lyra.Inst("Frame", {
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.fromOffset(22, 22),
		BorderSizePixel = 0
	}, switch)
	Lyra.Round(knob, 22)

	local object = element(card, {
		Flag = spec.Flag,
		Switch = switch
	})

	local function refresh(instant)
		window:_tint(switch, {
			BackgroundColor3 = value and "AccentDark" or "Raised"
		}, instant and 0 or nil)

		window:_tint(knob, {
			BackgroundColor3 = value and "Text" or "Muted"
		}, instant and 0 or nil, {
			Position = UDim2.fromOffset(value and 24 or 4, 4)
		})
	end

	function object:Set(newValue, silent)
		newValue = newValue == true
		if newValue == value then
			return
		end
		value = newValue
		refresh()
		window:_setFlag(spec.Flag, value)
		if not silent then
			window:_fire(spec.Callback, value)
		end
	end

	function object:Get()
		return value
	end

	function object:Toggle()
		object:Set(not value)
	end

	window:_on(switch.Activated, function()
		object:Set(not value)
	end)

	refresh(true)
	window:_registerFlag(spec.Flag, object)
	if restored then
		window:_fire(spec.Callback, value)
	end
	return object
end

function Container:Stepper(spec)
	spec = spec or {}
	local window = self.Window
	local values = Lyra.StepValues(spec)
	local format = spec.Format or function(v)
		return tostring(v) .. (spec.Suffix or "")
	end
	local value, restored = window:_initial(spec, spec.Default or values[1])

	local card = self:_add((window:_controlCard(self.Frame, spec.Title or "Stepper", spec.Description, 140)))
	local box = Lyra.Inst("Frame", {
		Size = UDim2.fromOffset(140, 38),
		Position = UDim2.new(1, -152, 0.5, -19),
		BackgroundTransparency = 1
	}, card)

	local label = window:_text(box, "", 13, "Text", true)
	label.Position = UDim2.fromOffset(38, 0)
	label.Size = UDim2.new(1, -76, 1, 0)
	label.TextXAlignment = Enum.TextXAlignment.Center

	local object = element(card, {Flag = spec.Flag})

	local function show()
		label.Text = tostring(format(value))
	end

	function object:Set(newValue, silent)
		if newValue == value then
			show()
			return
		end
		value = newValue
		show()
		window:_setFlag(spec.Flag, value)
		if not silent then
			window:_fire(spec.Callback, value)
		end
	end

	function object:Get()
		return value
	end

	local function step(direction)
		local index = 1
		for i, item in ipairs(values) do
			if item <= value then
				index = i
			end
		end
		object:Set(values[math.clamp(index + direction, 1, #values)])
	end

	local minus = window:_button(box, "", false, function()
		step(-1)
	end, "minus")
	minus.Root.Size = UDim2.fromOffset(36, 38)

	local plus = window:_button(box, "", false, function()
		step(1)
	end, "plus")
	plus.Root.Size = UDim2.fromOffset(36, 38)
	plus.Root.Position = UDim2.new(1, -36, 0, 0)

	show()
	window:_registerFlag(spec.Flag, object)
	if restored then
		window:_fire(spec.Callback, value)
	end
	return object
end

function Container:Slider(spec)
	spec = spec or {}
	local window, container = self.Window, self
	local min, max = tonumber(spec.Min) or 0, tonumber(spec.Max) or 100
	if max <= min then
		max = min + 1
	end
	local step = tonumber(spec.Step) or 1
	if step <= 0 then
		step = 1
	end
	local format = spec.Format or function(v)
		return tostring(v) .. (spec.Suffix or "")
	end
	local value, restored = window:_initial(spec, Lyra.Snap(math.clamp(tonumber(spec.Default) or min, min, max), step, min))

	local card = self:_add((window:_controlCard(self.Frame, spec.Title or "Slider", spec.Description, 176)))
	local holder = Lyra.Inst("Frame", {
		Size = UDim2.fromOffset(176, 38),
		Position = UDim2.new(1, -188, 0.5, -19),
		BackgroundTransparency = 1
	}, card)

	local label = window:_text(holder, "", 13, "Text", true)
	label.Size = UDim2.new(0, 52, 1, 0)
	label.TextXAlignment = Enum.TextXAlignment.Center

	local track = Lyra.Inst("Frame", {
		Position = UDim2.new(0, 64, 0.5, -3),
		Size = UDim2.new(1, -74, 0, 6),
		BorderSizePixel = 0
	}, holder)
	window:_paint(track, {BackgroundColor3 = "Raised"})
	Lyra.Round(track, 3)

	local fill = Lyra.Inst("Frame", {
		Size = UDim2.fromScale(0, 1),
		BorderSizePixel = 0
	}, track)
	window:_paint(fill, {BackgroundColor3 = "Accent"})
	Lyra.Round(fill, 3)

	local knob = Lyra.Inst("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(18, 18),
		BorderSizePixel = 0
	}, track)
	window:_paint(knob, {BackgroundColor3 = "Text"})
	Lyra.Round(knob, 9)
	window:_stroke(knob, 0.1, "AccentDark")

	local hit = Lyra.Inst("TextButton", {
		Position = UDim2.fromOffset(56, 0),
		Size = UDim2.new(1, -56, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false
	}, holder)

	local object = element(card, {Flag = spec.Flag})

	local function show(instant)
		local ratio = (value - min) / (max - min)
		label.Text = tostring(format(value))
		window:_tween(fill, {Size = UDim2.fromScale(ratio, 1)}, instant and 0 or 0.08)
		window:_tween(knob, {Position = UDim2.fromScale(ratio, 0.5)}, instant and 0 or 0.08)
	end

	function object:Set(newValue, silent)
		newValue = Lyra.Snap(math.clamp(tonumber(newValue) or min, min, max), step, min)
		if newValue == value then
			return
		end
		value = newValue
		show()
		window:_setFlag(spec.Flag, value)
		if not silent then
			window:_fire(spec.Callback, value)
		end
	end

	function object:Get()
		return value
	end

	local dragging, touch
	local function update(x)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		object:Set(min + math.clamp((x - track.AbsolutePosition.X) / width, 0, 1) * (max - min))
	end

	window:_on(hit.InputBegan, function(input)
		if not Lyra.IsPointer(input) then
			return
		end
		dragging = true
		touch = input.UserInputType == Enum.UserInputType.Touch and input or nil
		if container.Page then
			container.Page.ScrollingEnabled = false
		end
		update(input.Position.X)
	end)

	window:_connect(UserInputService.InputChanged, function(input)
		if not dragging then
			return
		end
		if touch and input ~= touch then
			return
		end
		if not touch and input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		update(input.Position.X)
	end)

	window:_connect(UserInputService.InputEnded, function(input)
		if dragging and ((touch and input == touch) or (not touch and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			dragging = false
			touch = nil
			if container.Page then
				container.Page.ScrollingEnabled = true
			end
			window:_fire(spec.Released, value)
		end
	end)

	show(true)
	window:_registerFlag(spec.Flag, object)
	if restored then
		window:_fire(spec.Callback, value)
	end
	return object
end

